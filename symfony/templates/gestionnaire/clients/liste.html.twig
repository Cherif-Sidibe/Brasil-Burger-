{% extends 'base.html.twig' %}

{% block title %}Clients
{% endblock %}

{% block body %}
	<div
		class="container-fluid py-4">
		{# En-tête #}
		<div class="d-flex justify-content-between align-items-center mb-4">
			<h1 class="h3 mb-0">
				<i class="fas fa-users me-2 text-brasil-yellow"></i>Gestion des Clients
			</h1>
			<span class="badge bg-secondary fs-6">{{ totalItems }}
				client{{ totalItems > 1 ? 's' : '' }}</span>
		</div>

		{# Messages flash #}
		{% for message in app.flashes('success') %}
			<div class="alert alert-success alert-dismissible fade show">
				<i class="fas fa-check-circle me-2"></i>
				{{ message }}
				<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
			</div>
		{% endfor %}
		{% for message in app.flashes('error') %}
			<div class="alert alert-danger alert-dismissible fade show">
				<i class="fas fa-exclamation-circle me-2"></i>
				{{ message }}
				<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
			</div>
		{% endfor %}

		{# Filtres #}
		<div class="card mb-4" style="border: 2px solid var(--brasil-yellow); overflow: hidden;">
			<div class="card-body">
				<form method="get" class="row g-3">
					<div class="col-md-6">
						<label class="form-label">Rechercher</label>
						<input type="text" name="recherche" class="form-control" placeholder="Nom, prénom, email, téléphone..." value="{{ recherche }}">
					</div>
					<div class="col-md-4">
						<label class="form-label">Statut</label>
						<select name="statut" class="form-select">
							<option value="">Tous</option>
							<option value="actif" {{ statut == 'actif' ? 'selected' : '' }}>Actifs</option>
							<option value="archive" {{ statut == 'archive' ? 'selected' : '' }}>Archivés</option>
						</select>
					</div>
					<div class="col-md-2 d-flex align-items-end">
						<button type="submit" class="btn btn-brasil-yellow w-100">
							<i class="fas fa-search me-2"></i>Filtrer
						</button>
					</div>
				</form>
			</div>
		</div>

		{# Tableau des clients #}
		<div class="card" style="border: 2px solid var(--brasil-yellow); overflow: hidden;">
			<div class="card-header border-0" style="background: var(--brasil-yellow); color: #000;">
				<i class="fas fa-list me-2"></i>Liste des clients
			</div>
			<div class="card-body p-0">
				{% if clients is empty %}
					<div class="p-5 text-center">
						<i class="fas fa-users fa-3x text-muted mb-3"></i>
						<h5 class="text-muted">Aucun client trouvé</h5>
					</div>
				{% else %}
					<div class="table-responsive">
						<table class="table table-hover mb-0">
							<thead>
								<tr>
									<th>ID</th>
									<th>Nom</th>
									<th>Téléphone</th>
									<th>Adresse</th>
									<th>Dernière commande</th>
									<th>Statut</th>
									<th class="text-end">Actions</th>
								</tr>
							</thead>
							<tbody>
								{% for client in clients %}
									<tr class="{{ client.isArchive ? 'opacity-50' : '' }}">
										<td class="align-middle">
											<span class="fw-bold text-brasil-yellow">#{{ client.id }}</span>
										</td>
										<td class="align-middle">
											<div>
												<span class="fw-bold">{{ client.nom }}
													{{ client.prenom }}</span><br>
												<small class="text-muted">{{ client.email }}</small>
											</div>
										</td>
										<td class="align-middle">
											{% if client.telephone %}
												<i class="fas fa-phone text-brasil-green me-1"></i>
												{{ client.telephone }}
											{% else %}
												<span class="text-muted">-</span>
											{% endif %}
										</td>
										<td class="align-middle">
											{% if client.adresse %}
												<small>{{ client.adresse|length > 30 ? client.adresse|slice(0, 30) ~ '...' : client.adresse }}</small>
											{% else %}
												<span class="text-muted">-</span>
											{% endif %}
										</td>
										<td class="align-middle">
											{% set derniereCommande = dernieresCommandes[client.id] %}
											{% if derniereCommande %}
												<a href="{{ path('gestionnaire_commandes_details', {id: derniereCommande.id}) }}" class="text-decoration-none">
													<span class="text-brasil-cyan">#{{ derniereCommande.id }}</span>
													<br><small class="text-muted">{{ derniereCommande.dateCommande|date('d/m/Y') }}</small>
												</a>
											{% else %}
												<span class="text-muted">Aucune</span>
											{% endif %}
										</td>
										<td class="align-middle">
											{% if client.isArchive %}
												<span class="badge bg-danger">Archivé</span>
											{% else %}
												<span class="badge bg-success">Actif</span>
											{% endif %}
										</td>
										<td class="align-middle text-end">
											{% if client.isArchive %}
												<form method="post" action="{{ path('gestionnaire_clients_restaurer', {id: client.id}) }}" class="d-inline">
													<button type="submit" class="btn btn-success btn-sm">
														<i class="fas fa-undo me-1"></i>Restaurer
													</button>
												</form>
											{% else %}
												<button type="button" class="btn btn-outline-danger btn-sm" data-bs-toggle="modal" data-bs-target="#archiverModal{{ client.id }}">
													<i class="fas fa-archive me-1"></i>Archiver
												</button>
											{% endif %}
										</td>
									</tr>
								{% endfor %}
							</tbody>
						</table>
					</div>
				{% endif %}
			</div>
		</div>

		{# Pagination #}
		<nav class="mt-4">
			<ul class="pagination justify-content-center">
				<li class="page-item {{ currentPage <= 1 ? 'disabled' : '' }}">
					<a class="page-link" href="{{ path('gestionnaire_clients_liste', {page: currentPage - 1, recherche: recherche, statut: statut}) }}">
						<i class="fas fa-chevron-left"></i> Précédent
					</a>
				</li>
				{% for i in 1..totalPages %}
					<li class="page-item {{ currentPage == i ? 'active' : '' }}">
						<a class="page-link" href="{{ path('gestionnaire_clients_liste', {page: i, recherche: recherche, statut: statut}) }}">{{ i }}</a>
					</li>
				{% endfor %}
				<li class="page-item {{ currentPage >= totalPages ? 'disabled' : '' }}">
					<a class="page-link" href="{{ path('gestionnaire_clients_liste', {page: currentPage + 1, recherche: recherche, statut: statut}) }}">
						Suivant <i class="fas fa-chevron-right"></i>
					</a>
				</li>
			</ul>
		</nav>
	</div>

	{# Modals d'archivage #}
	{% for client in clients %}
		{% if not client.isArchive %}
			<div class="modal fade" id="archiverModal{{ client.id }}" tabindex="-1">
				<div class="modal-dialog">
					<div class="modal-content bg-dark">
						<div class="modal-header border-secondary">
							<h5 class="modal-title">
								<i class="fas fa-archive me-2 text-warning"></i>Archiver ce client ?
							</h5>
							<button type="button" class="btn-close" data-bs-dismiss="modal"></button>
						</div>
						<div class="modal-body">
							Êtes-vous sûr de vouloir archiver
							<strong>{{ client.nom }}
								{{ client.prenom }}</strong>
							?
							<br><small class="text-muted">Ce client ne pourra plus passer de commandes.</small>
						</div>
						<div class="modal-footer border-secondary">
							<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
							<form method="post" action="{{ path('gestionnaire_clients_archiver', {id: client.id}) }}" class="d-inline">
								<button type="submit" class="btn btn-danger">Archiver</button>
							</form>
						</div>
					</div>
				</div>
			</div>
		{% endif %}
	{% endfor %}
{% endblock %}
