<!DOCTYPE html>
<html lang="fr">
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<title>Brasil Burger - Connexion Gestionnaire</title>

		<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet"/>
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.2/font/bootstrap-icons.css"/>

		<style>:root
		{
			--brasil-yellow: #ffd700;
			--brasil-gold: #ffc107;
		}

		body {
			background: #111;
			min-height: 100vh;
			font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
		}

		.login-box {
			background: #000;
			border: 2.5px solid var(--brasil-yellow);
			border-radius: 26px;
			padding: 32px 36px 28px;
			box-shadow: 0 10px 35px rgba(255, 215, 0, 0.18);
			width: 420px;
			max-width: 95vw;
			animation: fadeSlide 0.8s cubic-bezier(0.4, 1.4, 0.6, 1);
		}

		@keyframes fadeSlide {
			from {
				opacity: 0;
				transform: translateY(35px) scale(0.96);
			}
			to {
				opacity: 1;
				transform: translateY(0) scale(1);
			}
		}

		.login-title {
			color: var(--brasil-yellow);
			font-size: 1.7rem;
			font-weight: 700;
			text-align: center;
			margin-bottom: 22px;
			letter-spacing: 0.5px;
		}

		.input-group {
			background: #181818;
			border: 2px solid var(--brasil-yellow);
			border-radius: 16px;
			transition: all 0.25s ease;
			overflow: hidden;
		}

		.input-group:focus-within {
			box-shadow: 0 0 0 4px rgba(255, 215, 0, 0.15);
			transform: scale(1.015);
		}

		.input-group-text {
			background: transparent;
			border: none;
			color: var(--brasil-yellow);
			font-size: 1.25rem;
			padding-left: 18px;
		}

		.form-control {
			background: transparent;
			border: none;
			color: #fff;
			padding: 14px;
			font-size: 1.02rem;
		}

		.form-control::placeholder {
			color: #bbb;
		}

		.form-control:focus {
			box-shadow: none;
			background: transparent;
			color: #fff;
		}

		label {
			color: #fff;
			font-weight: 500;
			margin-bottom: 6px;
		}

		.form-check-input {
			accent-color: var(--brasil-yellow);
		}

		.form-check-label {
			color: #fff;
		}

		.login-btn {
			background: var(--brasil-yellow);
			color: #111;
			font-weight: 700;
			font-size: 1.1rem;
			border-radius: 14px;
			padding: 14px;
			transition: all 0.25s ease;
			letter-spacing: 0.6px;
		}

		.login-btn:hover {
			background: var(--brasil-gold);
			transform: translateY(-2px) scale(1.03);
			box-shadow: 0 10px 25px rgba(255, 215, 0, 0.3);
		}

		.login-btn:active {
			transform: scale(0.96);
		}

		.alert {
			border-radius: 14px;
			border: 2px solid;
		}

		.shake {
			animation: shake 0.4s ease;
		}

		@keyframes shake {
			0% {
				transform: translateX(0);
			}
			25% {
				transform: translateX(-6px);
			}
			50% {
				transform: translateX(6px);
			}
			75% {
				transform: translateX(-4px);
			}
			100% {
				transform: translateX(0);
			}
		}
	</style>
</head>

<body>
	<div class="d-flex justify-content-center align-items-center min-vh-100">
		<div class="login-box {% if error %}shake{% endif %}">

			<div class="text-center mb-3">
				<img src="https://d1mzjggyz5012h.cloudfront.net/whatsaf.com/logos/ba09d1b6bd0ea38a_75620eb8bad113b4_Logo-Brasil-Burger.png?width=300" alt="Brasil Burger" style="max-width: 180px" onerror="this.style.display='none'"/>
			</div>

			<div class="login-title">Espace Gestionnaire</div>

			{% if error %}
				<div class="alert alert-danger border-danger">
					<i class="bi bi-exclamation-triangle-fill"></i>
					{{ error.messageKey|trans(error.messageData, 'security') }}
				</div>
			{% endif %}

			<form method="post" action="{{ path('app_login') }}">

				<label for="email">Email</label>
				<div class="input-group mb-3">
					<span class="input-group-text">
						<i class="bi bi-envelope-fill"></i>
					</span>
					<input type="email" id="email" name="_username" class="form-control" placeholder="example@gmail.com" value="{{ last_username }}" required autofocus/>
				</div>

				<label for="password">Mot de passe</label>
				<div class="input-group mb-3">
					<span class="input-group-text">
						<i class="bi bi-lock-fill"></i>
					</span>
					<input type="password" id="password" name="_password" class="form-control" placeholder="••••••••" required/>
				</div>

				<div class="form-check mb-3">
					<input class="form-check-input" type="checkbox" id="remember" name="_remember_me"/>
					<label class="form-check-label" for="remember">
						Se souvenir de moi
					</label>
				</div>

				<input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}"/>

				<button type="submit" class="btn login-btn w-100">
					SE CONNECTER
				</button>

			</form>
		</div>
	</div>

	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body></html>
