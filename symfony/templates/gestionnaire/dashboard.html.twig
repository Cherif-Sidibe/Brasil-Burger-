{% extends "base.html.twig" %}

{% block title %}Dashboard - Brasil Burger
{% endblock %}

{% block body %}
	<h1 class="h2 mb-4">
		<i class="fa-solid fa-gauge-high text-warning"></i>
		Dashboard
	</h1>

	<div class="row g-4 mb-4">
		<div class="col-md-3">
			<div class="stat-card warning d-flex align-items-center gap-3">
				<i class="fa-solid fa-receipt stat-icon text-warning"></i>
				<div>
					<div class="stat-label">Commandes du jour</div>
					<div class="stat-value text-warning">66</div>
				</div>
			</div>
		</div>
		<div class="col-md-3">
			<div class="stat-card success d-flex align-items-center gap-3">
				<i class="fa-solid fa-circle-check stat-icon text-success"></i>
				<div>
					<div class="stat-label">Commandes validées</div>
					<div class="stat-value text-success">22</div>
				</div>
			</div>
		</div>
		<div class="col-md-3">
			<div class="stat-card info d-flex align-items-center gap-3">
				<i class="fa-solid fa-sack-dollar stat-icon text-info"></i>
				<div>
					<div class="stat-label">Recettes du jour</div>
					<div class="stat-value text-info">520 000</div>
				</div>
			</div>
		</div>
		<div class="col-md-3">
			<div class="stat-card danger d-flex align-items-center gap-3">
				<i class="fa-solid fa-circle-xmark stat-icon text-danger"></i>
				<div>
					<div class="stat-label">Commandes annulées</div>
					<div class="stat-value text-danger">66</div>
				</div>
			</div>
		</div>
	</div>

	<div class="row g-4">
		<div class="col-lg-8">
			<div class="card">
				<div class="card-header">Burgers / Menus les plus vendus</div>
				<div class="card-body">
					<table class="table table-hover align-middle">
						<thead>
							<tr>
								<th>Produit</th>
								<th>Type</th>
								<th class="text-center">Quantité</th>
								<th class="text-end">CA</th>
							</tr>
						</thead>
						<tbody>
							<tr>
								<td class="align-middle-custom">
									<img src="https://images.unsplash.com/photo-1568901346375-23c9450c58cd?w=100" class="product-image me-2 align-middle"/>
									<i class="fa-solid fa-hamburger text-warning me-1" style="font-size: 1.3em; vertical-align: middle"></i>
									Brasil Classic
								</td>
								<td class="align-middle-custom">
									<span class="badge bg-warning">
										<i class="fa-solid fa-hamburger me-1"></i>Burger
									</span>
								</td>
								<td class="text-center align-middle-custom">45</td>
								<td class="text-end text-warning align-middle-custom">157 500 FCFA</td>
							</tr>
							<tr>
								<td class="align-middle-custom">
									<img src="https://images.unsplash.com/photo-1550547660-d9450f859349?w=100" class="product-image me-2 align-middle"/>
									<i class="fa-solid fa-list-ul text-warning me-1"></i>
									Menu Cheese
								</td>
								<td class="align-middle-custom">
									<span class="badge bg-info">
										<i class="fa-solid fa-list-ul me-1"></i>Menu
									</span>
								</td>
								<td class="text-center align-middle-custom">38</td>
								<td class="text-end text-warning align-middle-custom">220 400 FCFA</td>
							</tr>
							<tr>
								<td class="align-middle-custom">
									<img src="https://images.unsplash.com/photo-1553979459-d2229ba7433b?w=100" class="product-image me-2 align-middle"/>
									<i class="fa-solid fa-hamburger text-warning me-1" style="font-size: 1.3em; vertical-align: middle"></i>
									BBQ Special
								</td>
								<td class="align-middle-custom">
									<span class="badge bg-warning">
										<i class="fa-solid fa-hamburger me-1"></i>Burger
									</span>
								</td>
								<td class="text-center align-middle-custom">32</td>
								<td class="text-end text-warning align-middle-custom">144 000 FCFA</td>
							</tr>
						</tbody>
					</table>
				</div>
			</div>
		</div>

		<div class="col-lg-4">
			<div class="card">
				<div class="card-header">Commandes récentes</div>
				<div class="card-body">
					<div class="commande-card commande-info">
						<div class="d-flex justify-content-between">
							<strong>#CMD00015</strong>
							<span class="badge bg-info commande-badge">En préparation</span>
						</div>
						<small>Client : Diallo Amadou</small>
						<div class="text-warning fw-bold">5 800 FCFA</div>
					</div>
					<div class="commande-card commande-success">
						<div class="d-flex justify-content-between">
							<strong>#CMD00014</strong>
							<span class="badge bg-success commande-badge">Terminée</span>
						</div>
						<small>Client : Ndiaye Fatou</small>
						<div class="text-warning fw-bold">6 200 FCFA</div>
					</div>
				</div>
			</div>
		</div>
	</div>
{% endblock %}
