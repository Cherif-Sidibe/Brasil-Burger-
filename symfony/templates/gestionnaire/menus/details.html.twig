{% extends "base.html.twig" %}

{% block title %}
	{{ menu.nom }}
	- Brasil Burger
{% endblock %}

{% block body %}
	<div class="d-flex justify-content-between align-items-center mb-4">
		<h1 class="h2">
			<i class="fa-solid fa-utensils text-warning"></i>
			Détails du Menu
		</h1>
		<a href="{{ path('gestionnaire_menus_liste') }}" class="btn btn-secondary">
			<i class="fa-solid fa-arrow-left"></i>
			Retour à la liste
		</a>
	</div>

	<!-- Messages flash -->
	{% for message in app.flashes('success') %}
		<div class="alert alert-success alert-dismissible fade show" role="alert">
			{{ message }}
			<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
		</div>
	{% endfor %}
	{% for message in app.flashes('error') %}
		<div class="alert alert-danger alert-dismissible fade show" role="alert">
			{{ message }}
			<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
		</div>
	{% endfor %}

	<div
		class="row">
		<!-- Image et informations principales -->
		<div class="col-lg-5">
			<div class="card mb-4">
				<div class="card-body">
					{% if menu.image %}
						<img src="{{ menu.image }}" class="img-fluid rounded mb-3" alt="{{ menu.nom }}" style="width: 100%; max-height: 400px; object-fit: cover;" onerror="this.src='https://via.placeholder.com/400x400?text=Pas+d\'image'"/>
					{% else %}
						<div class="d-flex align-items-center justify-content-center bg-secondary rounded mb-3" style="height: 400px;">
							<i class="fa-solid fa-utensils fa-5x text-warning"></i>
						</div>
					{% endif %}

					<h2 class="text-warning mb-3">{{ menu.nom }}</h2>

					<div class="d-flex justify-content-between align-items-center mb-3">
						<div>
							<h3 class="text-warning mb-0">{{ menu.prix|number_format(0, ',', ' ') }}
								FCFA</h3>
						</div>
						<div>
							{% if menu.isArchive %}
								<span class="badge bg-secondary fs-6">
									<i class="fa-solid fa-archive"></i>
									Archivé
								</span>
							{% else %}
								<span class="badge bg-success fs-6">
									<i class="fa-solid fa-check-circle"></i>
									Actif
								</span>
							{% endif %}
						</div>
					</div>

					<div class="d-grid gap-2">
						{% if menu.isArchive %}
							<button type="button" class="btn btn-success" onclick="showConfirmModal('Restaurer ce menu', 'Voulez-vous vraiment restaurer « {{ menu.nom }} » ?', '{{ path('gestionnaire_menus_restaurer') }}?id={{ menu.id }}')">
								<i class="fa-solid fa-rotate-left"></i>
								Restaurer le menu
							</button>
						{% else %}
							<button type="button" class="btn btn-danger" onclick="showConfirmModal('Archiver ce menu', 'Voulez-vous vraiment archiver « {{ menu.nom }} » ?', '{{ path('gestionnaire_menus_archiver') }}?id={{ menu.id }}')">
								<i class="fa-solid fa-archive"></i>
								Archiver le menu
							</button>
						{% endif %}
					</div>
				</div>
			</div>
		</div>

		<!-- Description et statistiques -->
		<div
			class="col-lg-7">
			<!-- Composition du menu -->
			<div class="card mb-4">
				<div class="card-header">
					<h5 class="mb-0">
						<i class="fa-solid fa-list"></i>
						Composition du menu
					</h5>
				</div>
				<div class="card-body">
					<div class="row g-3">
						<div class="col-md-4">
							<div class="card bg-dark border-warning">
								<div class="card-body text-center">
									<i class="fa-solid fa-hamburger fa-2x text-warning mb-2"></i>
									<h6 class="text-warning mb-1">Burger</h6>
									<p class="mb-0">{{ menu.burger.nom }}</p>
								</div>
							</div>
						</div>
						<div class="col-md-4">
							<div class="card bg-dark border-info">
								<div class="card-body text-center">
									<i class="fa-solid fa-wine-bottle fa-2x text-info mb-2"></i>
									<h6 class="text-info mb-1">Boisson</h6>
									<p class="mb-0">{{ menu.boisson.nom }}</p>
								</div>
							</div>
						</div>
						<div class="col-md-4">
							<div class="card bg-dark border-danger">
								<div class="card-body text-center">
									<i class="fa-solid fa-fries fa-2x text-danger mb-2"></i>
									<h6 class="text-danger mb-1">Frite</h6>
									<p class="mb-0">{{ menu.frite.nom }}</p>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>

			<!-- Description -->
			{% if menu.description %}
				<div class="card mb-4">
					<div class="card-header">
						<h5 class="mb-0">
							<i class="fa-solid fa-align-left"></i>
							Description
						</h5>
					</div>
					<div class="card-body">
						<p class="mb-0">{{ menu.description }}</p>
					</div>
				</div>
			{% endif %}

			<!-- Statistiques de vente -->
			<div class="card mb-4">
				<div class="card-header">
					<h5 class="mb-0">
						<i class="fa-solid fa-chart-line"></i>
						Statistiques de vente
					</h5>
				</div>
				<div class="card-body">
					<div class="row text-center">
						<div class="col-md-6">
							<div class="p-4 rounded" style="background: linear-gradient(135deg, var(--brasil-yellow) 0%, #ffed4e 100%);">
								<i class="fa-solid fa-shopping-cart fa-2x text-dark mb-2"></i>
								<h3 class="text-dark mb-0">{{ total_ventes }}</h3>
								<p class="text-dark mb-0 fw-bold">Ventes totales</p>
							</div>
						</div>
						<div class="col-md-6">
							<div class="p-4 rounded" style="background: linear-gradient(135deg, var(--brasil-green) 0%, #3be381 100%);">
								<i class="fa-solid fa-coins fa-2x text-white mb-2"></i>
								<h3 class="text-white mb-0">{{ (menu.prix * total_ventes)|number_format(0, ',', ' ') }}
									FCFA</h3>
								<p class="text-white mb-0 fw-bold">Chiffre d'affaires</p>
							</div>
						</div>
					</div>
				</div>
			</div>

			<!-- Informations système -->
			<div class="card">
				<div class="card-header">
					<h5 class="mb-0">
						<i class="fa-solid fa-info-circle"></i>
						Informations système
					</h5>
				</div>
				<div class="card-body">
					<dl class="row mb-0">
						<dt class="col-sm-4">ID</dt>
						<dd class="col-sm-8">{{ menu.id }}</dd>

						<dt class="col-sm-4">Date de création</dt>
						<dd class="col-sm-8">
							{% if menu.createdAt %}
								{{ menu.createdAt|date('d/m/Y à H:i') }}
							{% else %}
								Non renseignée
							{% endif %}
						</dd>

						<dt class="col-sm-4">Dernière modification</dt>
						<dd class="col-sm-8">
							{% if menu.updatedAt %}
								{{ menu.updatedAt|date('d/m/Y à H:i') }}
							{% else %}
								Non renseignée
							{% endif %}
						</dd>

						<dt class="col-sm-4">Statut</dt>
						<dd class="col-sm-8 mb-0">
							{% if menu.isArchive %}
								<span class="badge bg-secondary">Archivé</span>
							{% else %}
								<span class="badge bg-success">Actif</span>
							{% endif %}
						</dd>
					</dl>
				</div>
			</div>
		</div>
	</div>

	<!-- Modal de confirmation personnalisé -->
	<div class="modal fade" id="confirmModal" tabindex="-1">
		<div class="modal-dialog modal-dialog-centered">
			<div class="modal-content" style="background: var(--brasil-card); border: 2px solid var(--brasil-yellow);">
				<div class="modal-header border-bottom border-secondary">
					<h5 class="modal-title text-warning">
						<i class="fa-solid fa-circle-exclamation"></i>
						<span id="confirmModalTitle"></span>
					</h5>
					<button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
				</div>
				<div class="modal-body text-white">
					<p id="confirmModalMessage"></p>
				</div>
				<div class="modal-footer border-top border-secondary">
					<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
						<i class="fa-solid fa-times"></i>
						Annuler
					</button>
					<form method="post" id="confirmModalForm" class="d-inline">
						<button type="submit" class="btn btn-warning">
							<i class="fa-solid fa-check"></i>
							Confirmer
						</button>
					</form>
				</div>
			</div>
		</div>
	</div>

	<script>
		function showConfirmModal(title, message, actionUrl) {
document.getElementById('confirmModalTitle').textContent = title;
document.getElementById('confirmModalMessage').textContent = message;
document.getElementById('confirmModalForm').action = actionUrl;

const modal = new bootstrap.Modal(document.getElementById('confirmModal'));
modal.show();
}
	</script>
{% endblock %}
