@model VueClient.Models.Commande
@{
    ViewData["Title"] = "Détails de la commande #" + Model.Id;
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <!-- En-tête de confirmation -->
            <div class="text-center mb-4">
                <div class="mb-3">
                    <i class="bi bi-check-circle-fill text-success" style="font-size: 4rem;"></i>
                </div>
                <h1 class="h2 text-success">Commande confirmée !</h1>
                <p class="text-muted">Merci pour votre commande. Voici le récapitulatif.</p>
            </div>

            <!-- Carte de la commande -->
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="bi bi-receipt me-2"></i>Commande #@Model.Id
                    </h5>
                    <span class="badge bg-light text-primary">
                        @Model.EtatCommande.ToString().Replace("_", " ")
                    </span>
                </div>
                <div class="card-body">
                    <!-- Informations générales -->
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <p class="mb-1"><strong>Date :</strong></p>
                            <p class="text-muted">@Model.DateCommande.ToString("dd/MM/yyyy à HH:mm")</p>
                        </div>
                        <div class="col-md-6">
                            <p class="mb-1"><strong>Type de livraison :</strong></p>
                            <p class="text-muted">
                                @if (Model.TypeLivraison == VueClient.Models.TypeLivraisonEnum.SUR_PLACE)
                                {
                                    <i class="bi bi-shop me-1"></i>
                                
                                    @:Sur place
                                }
                                else if (Model.TypeLivraison == VueClient.Models.TypeLivraisonEnum.A_RECUPERER)
                                {
                                    <i class="bi bi-bag me-1"></i>
                                
                                    @:À récupérer
                                }
                                else
                                {
                                    <i class="bi bi-truck me-1"></i>
                                
                                    @:Livraison
                                }
                            </p>
                        </div>
                    </div>

                    @if (Model.TypeLivraison == VueClient.Models.TypeLivraisonEnum.A_LIVRER &&
                                        !string.IsNullOrEmpty(Model.AdresseLivraison))
                    {
                        <div class="mb-4">
                            <p class="mb-1"><strong>Adresse de livraison :</strong></p>
                            <p class="text-muted">
                                <i class="bi bi-geo-alt me-1"></i>@Model.AdresseLivraison
                            </p>
                        </div>
                    }

                    <!-- Détails des articles -->
                    <h6 class="border-bottom pb-2 mb-3">
                        <i class="bi bi-list-ul me-2"></i>Articles commandés
                    </h6>

                    @if (Model.DetailCommandes != null && Model.DetailCommandes.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped">
                                <thead class="table-light">
                                    <tr>
                                        <th>Article</th>
                                        <th class="text-center">Quantité</th>
                                        <th class="text-end">Prix unitaire</th>
                                        <th class="text-end">Sous-total</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var detail in Model.DetailCommandes)
                                    {
                                        <tr>
                                            <td>
                                                <span class="badge bg-secondary me-2">@detail.TypeArticle</span>
                                                Article #@detail.IdArticle
                                            </td>
                                            <td class="text-center">@detail.Quantite</td>
                                            <td class="text-end">@detail.PrixUnitaire.ToString("N0") FCFA</td>
                                            <td class="text-end fw-bold">@detail.SousTotal.ToString("N0") FCFA</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted text-center">Aucun détail disponible</p>
                    }

                    <!-- Total -->
                    <div class="d-flex justify-content-end mt-3">
                        <div class="bg-light p-3 rounded">
                            <h5 class="mb-0">
                                Total : <span class="text-primary">@Model.MontantTotal.ToString("N0") FCFA</span>
                            </h5>
                        </div>
                    </div>
                </div>

                <!-- Pied de carte avec actions -->
                <div class="card-footer bg-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <a href="@Url.Action("MesCommandes", "Commande")" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-2"></i>Mes commandes
                        </a>
                        <a href="@Url.Action("Index", "Catalogue")" class="btn btn-primary">
                            <i class="bi bi-shop me-2"></i>Continuer mes achats
                        </a>
                    </div>
                </div>
            </div>

            <!-- Informations supplémentaires -->
            <div class="mt-4 text-center text-muted">
                <p>
                    <i class="bi bi-info-circle me-1"></i>
                    Un email de confirmation vous sera envoyé prochainement.
                </p>
                <p>
                    <i class="bi bi-telephone me-1"></i>
                    Pour toute question, contactez-nous au <strong>+221 XX XXX XX XX</strong>
                </p>
            </div>
        </div>
    </div>
</div>