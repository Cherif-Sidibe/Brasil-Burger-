@model VueClient.Models.Commande
@{
    ViewData["Title"] = "Suivi de commande #" + Model.Id;
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />

<style>
    :root {
        --brasil-dark: #000000;
        --brasil-gray: #1a1a1a;
        --brasil-yellow: #ffc107;
        --brasil-green: #4caf50;
    }

    body {
        background-color: var(--brasil-dark);
        color: #fff;
    }

    .brasil-container {
        background-color: var(--brasil-dark);
        min-height: 100vh;
        padding: 40px 20px;
        color: #fff;
    }

    .brasil-card {
        background-color: var(--brasil-gray);
        border: 2px solid var(--brasil-yellow);
        border-radius: 15px;
        padding: 30px;
        color: #fff;
    }

    .brasil-title {
        color: var(--brasil-yellow);
        font-weight: bold;
        margin-bottom: 20px;
    }

    .brasil-order-number {
        color: var(--brasil-yellow);
        font-size: 28px;
        font-weight: bold;
        text-align: center;
        margin: 20px 0;
    }

    .brasil-status-badge {
        border: 1px solid var(--brasil-green);
        color: var(--brasil-green);
        padding: 5px 15px;
        border-radius: 20px;
        display: inline-block;
        text-align: center;
        font-size: 12px;
        font-weight: bold;
    }

    .progress-circle {
        width: 200px;
        height: 200px;
        border-radius: 50%;
        background: conic-gradient(var(--brasil-yellow) 0deg 270deg, rgba(255, 193, 7, 0.2) 270deg);
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 30px auto;
        position: relative;
        box-shadow: inset 0 0 20px rgba(255, 193, 7, 0.2);
        transition: background 0.5s ease;
    }

    .progress-circle-inner {
        width: 180px;
        height: 180px;
        border-radius: 50%;
        background-color: var(--brasil-dark);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-direction: column;
        font-size: 60px;
        color: var(--brasil-yellow);
    }

    .progress-status {
        font-size: 14px;
        color: #fff;
        margin-top: 10px;
        text-align: center;
        transition: all 0.3s ease;
    }

    .brasil-summary-item {
        display: flex;
        justify-content: space-between;
        padding: 10px 0;
        border-bottom: 1px solid rgba(255, 193, 7, 0.3);
        color: #fff;
    }

    .brasil-summary-item:last-child {
        border-bottom: none;
    }

    .brasil-total {
        background-color: rgba(255, 193, 7, 0.1);
        border-radius: 10px;
        padding: 15px;
        margin-top: 20px;
        font-weight: bold;
        font-size: 18px;
        color: var(--brasil-yellow);
    }

    .brasil-delivery-info {
        margin-top: 20px;
        padding: 15px;
        background-color: rgba(255, 193, 7, 0.1);
        border-radius: 10px;
        text-align: center;
        font-weight: bold;
        color: var(--brasil-yellow);
    }

    .brasil-btn-outline {
        background: transparent;
        border: 2px solid var(--brasil-yellow);
        color: var(--brasil-yellow);
        padding: 15px 40px;
        border-radius: 30px;
        font-weight: bold;
        cursor: pointer;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-block;
    }

    .brasil-btn-outline:hover {
        background-color: var(--brasil-yellow);
        color: var(--brasil-dark);
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(255, 193, 7, 0.3);
    }
</style>

<div class="brasil-container">
    <div class="container">
        <div class="row">
            <!-- Colonne gauche : Suivi de commande -->
            <div class="col-lg-6">
                <div class="brasil-card">
                    <h2 class="brasil-title" style="text-align: center;">Suivi de commande</h2>

                    <div class="brasil-order-number">#BR2025-@Model.Id.ToString("00000")</div>

                    <div style="text-align: center;">
                        <span class="brasil-status-badge">
                            @if (Model.TypeLivraison == VueClient.Models.TypeLivraisonEnum.SUR_PLACE)
                            {
                                @:Sur place
                            }
                            else if (Model.TypeLivraison == VueClient.Models.TypeLivraisonEnum.A_RECUPERER)
                            {
                                @:À récupérer
                            }
                            else
                            {
                                @:Livraison
                            }
                        </span>
                    </div>

                    <div class="progress-circle" id="progressCircle">
                        <div class="progress-circle-inner">
                            <i class="bi bi-flame"></i>
                        </div>
                    </div>

                    <div class="progress-status" id="statusText">
                        @switch (Model.EtatCommande)
                        {
                            case VueClient.Models.EtatCommandeEnum.EN_ATTENTE:
                                @:En attente
                                break;
                            case VueClient.Models.EtatCommandeEnum.CONFIRMEE:
                                @:Confirmée
                                break;
                            case VueClient.Models.EtatCommandeEnum.EN_PREPARATION:
                                @:En préparation
                                break;
                            case VueClient.Models.EtatCommandeEnum.PRETE:
                                @:Prête
                                break;
                            case VueClient.Models.EtatCommandeEnum.LIVREE:
                                @:Livrée
                                break;
                            case VueClient.Models.EtatCommandeEnum.RETIREE:
                                @:Retirée
                                break;
                            case VueClient.Models.EtatCommandeEnum.CONSOMMEE_SUR_PLACE:
                                @:Consommée sur place
                                break;
                            case VueClient.Models.EtatCommandeEnum.ANNULEE:
                                @:Annulée
                                break;
                        }
                    </div>

                    
                </div>
            </div>

            <!-- Colonne droite : Résumé de la commande -->
            <div class="col-lg-6">
                <div class="brasil-card">
                    <h2 class="brasil-title">Résumé de la commande</h2>

                    @if (Model.DetailCommandes != null && Model.DetailCommandes.Any())
                    {
                        @foreach (var detail in Model.DetailCommandes)
                        {
                            <div class="brasil-summary-item">
                                <span>Article #@detail.IdArticle (@detail.Quantite)x</span>
                                <span>@detail.SousTotal.ToString("N0") FCFA</span>
                            </div>
                        }
                    }

                    <div class="brasil-summary-item">
                        <span>Sous-total</span>
                        <span>@Model.DetailCommandes?.Sum(d => d.SousTotal).ToString("N0") FCFA</span>
                    </div>

                    <div class="brasil-summary-item">
                        <span>Frais de livraison</span>
                        <span>@(Model.MontantTotal - (Model.DetailCommandes?.Sum(d => d.SousTotal) ?? 0)).ToString("N0")
                            FCFA</span>
                    </div>

                    <div class="brasil-total">
                        <div style="display: flex; justify-content: space-between;">
                            <span>Total</span>
                            <span>@Model.MontantTotal.ToString("N0") FCFA</span>
                        </div>
                    </div>

                    <div class="brasil-delivery-info">
                        @if (Model.TypeLivraison == VueClient.Models.TypeLivraisonEnum.SUR_PLACE)
                        {
                            @:Sur place
                        }
                        else if (Model.TypeLivraison == VueClient.Models.TypeLivraisonEnum.A_RECUPERER)
                        {
                            @:À récupérer
                        }
                        else if (!string.IsNullOrEmpty(Model.AdresseLivraison))
                        {
                            @:@Model.AdresseLivraison
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Bouton de contact -->
        <div style="text-align: center; margin-top: 40px;">
            <a href="#contact" class="brasil-btn-outline">
                <i class="bi bi-headset me-2"></i>Contacter Le Support Client
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Suivi en temps réel de la commande
        let previousStatus = '@Model.EtatCommande';
        const commandeId = @Model.Id;

        // Fonction pour obtenir le pourcentage de progression
        function getProgressPercentage(etat) {
            const statusMap = {
                'EN_ATTENTE': 15,
                'CONFIRMEE': 30,
                'EN_PREPARATION': 60,
                'PRETE': 85,
                'LIVREE': 100,
                'RETIREE': 100,
                'CONSOMMEE_SUR_PLACE': 100,
                'ANNULEE': 0
            };
            return statusMap[etat] || 15;
        }

        // Fonction pour obtenir le texte du statut
        function getStatusText(etat) {
            const textMap = {
                'EN_ATTENTE': 'En attente',
                'CONFIRMEE': 'Confirmée',
                'EN_PREPARATION': 'En préparation',
                'PRETE': 'Prête',
                'LIVREE': 'Livrée',
                'RETIREE': 'Retirée',
                'CONSOMMEE_SUR_PLACE': 'Consommée sur place',
                'ANNULEE': 'Annulée'
            };
            return textMap[etat] || etat;
        }

        // Fonction pour mettre à jour l'interface
        function updateUI(etat) {
            const percentage = getProgressPercentage(etat);
            const statusText = getStatusText(etat);
            const progressCircle = document.getElementById('progressCircle');
            const statusTextElement = document.getElementById('statusText');

            // Mettre à jour le cercle de progression
            const degrees = (percentage / 100) * 360;
            progressCircle.style.background = `conic-gradient(
                    var(--brasil-yellow) 0deg ${degrees}deg,
                    rgba(255, 193, 7, 0.2) ${degrees}deg
                )`;

            // Mettre à jour le texte du statut avec animation
            statusTextElement.style.opacity = '0';
            setTimeout(() => {
                statusTextElement.textContent = statusText;
                statusTextElement.style.opacity = '1';
            }, 150);

            // Notification si le statut a changé
            if (etat !== previousStatus) {
                if (typeof showToast === 'function') {
                    showToast(`Statut de votre commande : ${statusText}`, 'success');
                }
                previousStatus = etat;
            }
        }

        // Fonction pour vérifier le statut de la commande
        async function checkCommandeStatus() {
            try {
                const response = await fetch(`@Url.Action("GetCommandeStatus", "Commande")?id=${commandeId}`);
                if (response.ok) {
                    const data = await response.json();
                    updateUI(data.etatCommande);
                }
            } catch (error) {
                console.error('Erreur lors de la vérification du statut:', error);
            }
        }

        // Mettre à jour le statut au chargement de la page
        updateUI(previousStatus);

        // Vérifier le statut toutes les 10 secondes
        setInterval(checkCommandeStatus, 10000);
    </script>
}