<!DOCTYPE html>
<html lang="fr" data-bs-theme="dark">
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<title>
			{% block title %}Brasil Burger
			{% endblock %}
		</title>

		<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet"/>
		<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.2/font/bootstrap-icons.css" rel="stylesheet"/>
		<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css" crossorigin="anonymous"/>

		<style>:root
		{
			--brasil-yellow: #ffd700;
			--brasil-green: #2ecc71;
			--brasil-cyan: #2fd6d6;
			--brasil-red: #ff3b3b;
			--brasil-dark: #050505;
			--brasil-card: #1c1f22;
		}

		body {
			background: radial-gradient(circle at top, #111, #000);
			color: #fff;
			font-family: "Segoe UI", system-ui, sans-serif;
		}

		.navbar {
			background: #000;
			border-bottom: 3px solid var(--brasil-yellow);
		}

		.navbar-brand span {
			color: var(--brasil-yellow);
			font-weight: 800;
		}

		.sidebar {
			background: linear-gradient(180deg, #0b0b0b, #000);
			border-right: 4px solid var(--brasil-yellow);
			min-height: 100vh;
		}

		.sidebar .nav-link {
			color: #ddd;
			padding: 14px 22px;
			margin: 6px 10px;
			border-radius: 10px;
			transition: all 0.3s ease;
		}

		.sidebar .nav-link i {
			margin-right: 10px;
		}

		.sidebar .nav-link:hover {
			background: rgba(255, 215, 0, 0.12);
			color: #fff;
		}

		.sidebar .nav-link.active {
			background: rgba(255, 215, 0, 0.2);
			color: var(--brasil-yellow);
			font-weight: 600;
		}

		h1.h2 {
			font-weight: 700;
		}

		.stat-card {
			background: var(--brasil-card);
			border-radius: 22px;
			padding: 22px;
			border: 3px solid transparent;
			transition: transform 0.3s ease, box-shadow 0.3s ease;
		}

		.stat-card:hover {
			transform: translateY(-6px);
			box-shadow: 0 15px 40px rgba(0, 0, 0, 0.6);
		}

		.stat-card.warning {
			border-color: var(--brasil-yellow);
		}
		.stat-card.success {
			border-color: var(--brasil-green);
		}
		.stat-card.info {
			border-color: var(--brasil-cyan);
		}
		.stat-card.danger {
			border-color: var(--brasil-red);
		}

		.stat-value {
			font-size: 2.5rem;
			font-weight: 800;
		}

		.stat-label {
			font-size: 0.85rem;
			text-transform: uppercase;
			opacity: 0.7;
		}

		.stat-icon {
			font-size: 3rem;
			opacity: 0.15;
		}

		.card {
			background: var(--brasil-card);
			border-radius: 22px;
			border: 3px solid var(--brasil-yellow);
		}

		.card-header {
			background: #ffd90025;
			border-bottom: 2px solid var(--brasil-yellow);
			font-weight: 600;
		}

		.table {
			color: #fff;
		}

		.table thead {
			background: #101214;
		}

		.table th {
			color: var(--brasil-yellow);
			border-bottom: 2px solid var(--brasil-yellow);
		}

		.table td {
			border-color: #333;
		}

		.product-image {
			width: 55px;
			height: 55px;
			border-radius: 12px;
			border: 2px solid var(--brasil-yellow);
			object-fit: cover;
			vertical-align: middle;
			background: #222;
		}

		.align-middle-custom {
			vertical-align: middle !important;
		}

		.commande-card {
			background: linear-gradient(145deg, #1a1d20, #0e0f11);
			border-radius: 16px;
			padding: 16px;
			margin-bottom: 14px;
			border: 2px solid transparent;
		}

		.commande-warning {
			border-color: var(--brasil-yellow);
		}
		.commande-success {
			border-color: var(--brasil-green);
		}
		.commande-info {
			border-color: var(--brasil-cyan);
		}

		.commande-badge {
			padding: 5px 12px;
			border-radius: 12px;
			font-size: 0.75rem;
			font-weight: 600;
		}

		.badge.bg-warning {
			background: var(--brasil-yellow) !important;
			color: #000 !important;
		}
		.badge.bg-success {
			background: var(--brasil-green) !important;
		}
		.badge.bg-info {
			background: var(--brasil-cyan) !important;
		}

		{% block styles %}{% endblock %}
	</style>
</head>
<body>
	{% include 'components/_navbar.html.twig' %}

	<div class="container-fluid">
		<div class="row">
			{% include 'components/_sidebar.html.twig' %}

			<main class="col-md-9 col-lg-10 px-4 py-4"> {% block body %}{% endblock %}
				</main>
			</div>
		</div>

		<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
		{% block scripts %}{% endblock %}
	</body>
</html>
