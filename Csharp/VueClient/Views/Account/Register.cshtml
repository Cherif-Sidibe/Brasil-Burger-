@model dynamic
@{
    ViewData["Title"] = "Inscription";
    Layout = null;
}
<!DOCTYPE html>
<html lang="fr" data-bs-theme="dark">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Brasil Burger - Inscription</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.2/font/bootstrap-icons.css" />
    <style>
        :root {
            --brasil-yellow: #ffc107;
            --brasil-dark: #000000;
            --brasil-gray: #0f0f0f;
            --brasil-gold: #ffb800;
        }

        html, body {
            height: 100%;
            margin: 0;
            padding: 0;
            overflow: hidden;
        }

        .inscription-wrapper {
            height: 100vh;
            display: flex;
        }

        .inscription-left {
            flex: 1;
            background: linear-gradient(135deg, var(--brasil-dark) 0%, #1a1a1a 100%);
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 3rem;
            position: relative;
            overflow: hidden;
        }

        .inscription-left::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-image: url("https://images.unsplash.com/photo-1550547660-d9450f859349?w=800");
            background-size: cover;
            background-position: center;
            opacity: 0.15;
            z-index: 0;
        }

        .inscription-left-content {
            position: relative;
            z-index: 1;
            text-align: center;
        }

        .inscription-left .brand-title {
            font-size: 5rem;
            margin-bottom: 0;
            color: white;
            font-weight: 900;
            text-shadow: 4px 4px 8px rgba(0, 0, 0, 0.5);
        }

        .inscription-left .brand-subtitle {
            font-size: 2.5rem;
            margin-top: -0.5rem;
            color: var(--brasil-yellow);
            font-weight: 800;
            text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);
        }

        .inscription-left .brand-tagline {
            font-size: 1rem;
            margin-top: 0.5rem;
            color: white;
        }

        .inscription-description {
            margin-top: 2rem;
            max-width: 400px;
        }

        .inscription-description h3 {
            color: var(--brasil-yellow);
            font-size: 1.5rem;
            margin-bottom: 1rem;
        }

        .inscription-description p {
            color: rgba(255, 255, 255, 0.7);
            line-height: 1.6;
        }

        .inscription-right {
            flex: 1;
            background-color: var(--brasil-gray);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem;
            overflow-y: auto;
        }

        .inscription-form-container {
            width: 100%;
            max-width: 500px;
        }

        .progress-steps {
            display: flex;
            justify-content: space-between;
            margin-bottom: 2rem;
            position: relative;
        }

        .progress-steps::before {
            content: "";
            position: absolute;
            top: 20px;
            left: 0;
            right: 0;
            height: 2px;
            background-color: rgba(255, 215, 0, 0.2);
            z-index: 0;
        }

        .step {
            position: relative;
            z-index: 1;
            text-align: center;
            flex: 1;
        }

        .step-number {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background-color: rgba(255, 215, 0, 0.2);
            color: rgba(255, 255, 255, 0.5);
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 0.5rem;
            font-weight: bold;
            transition: all 0.3s;
        }

        .step.active .step-number {
            background-color: var(--brasil-yellow);
            color: #000;
            transform: scale(1.1);
        }

        .step.completed .step-number {
            background-color: var(--brasil-yellow);
            color: #000;
        }

        .step-label {
            font-size: 0.75rem;
            color: rgba(255, 255, 255, 0.5);
        }

        .step.active .step-label {
            color: var(--brasil-yellow);
            font-weight: 600;
        }

        .step.completed .step-label {
            color: rgba(255, 255, 255, 0.7);
        }

        .form-step {
            display: none;
        }

        .form-step.active {
            display: block;
            animation: fadeIn 0.3s;
        }

        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateX(20px);
            }
            to {
                opacity: 1;
                transform: translateX(0);
            }
        }

        .form-floating label {
            color: rgba(255, 255, 255, 0.6);
        }

        .form-floating input:focus ~ label,
        .form-floating select:focus ~ label {
            color: var(--brasil-yellow);
        }

        .form-control, .form-select {
            background-color: rgba(255, 255, 255, 0.1);
            border: 2px solid rgba(255, 215, 0, 0.3);
            color: white;
        }

        .form-control:focus, .form-select:focus {
            background-color: rgba(255, 255, 255, 0.15);
            border-color: var(--brasil-yellow);
            color: white;
            box-shadow: 0 0 0 0.2rem rgba(255, 193, 7, 0.25);
        }

        .form-select {
            color: white !important;
        }

        .form-select option {
            background-color: var(--brasil-gray);
            color: white;
        }

        .form-control::placeholder {
            color: rgba(255, 255, 255, 0.5);
        }

        .btn-next,
        .btn-prev,
        .btn-submit {
            background: linear-gradient(135deg, var(--brasil-yellow) 0%, var(--brasil-gold) 100%);
            border: none;
            color: #000;
            font-weight: 700;
            padding: 0.75rem 2rem;
            border-radius: 50px;
            transition: all 0.3s;
        }

        .btn-next:hover,
        .btn-prev:hover,
        .btn-submit:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(255, 215, 0, 0.3);
        }

        .btn-prev {
            background: transparent;
            border: 2px solid var(--brasil-yellow);
            color: var(--brasil-yellow);
        }

        @@media (max-width: 992px) {
            .inscription-wrapper {
                flex-direction: column;
            }

            .inscription-left {
                min-height: 30vh;
            }

            .inscription-right {
                min-height: 70vh;
            }

            .inscription-left .brand-title {
                font-size: 3rem;
            }

            .inscription-left .brand-subtitle {
                font-size: 1.5rem;
            }

            .inscription-description {
                display: none;
            }
        }
    </style>
</head>
<body>
    <div class="inscription-wrapper">
        <!-- Partie gauche - Logo -->
        <div class="inscription-left">
            <div class="inscription-left-content">
                <div class="logo-container">
                    <h1 class="brand-title">Brasil</h1>
                    <h2 class="brand-subtitle">BURGER</h2>
                    <p class="brand-tagline">TRÈS DÉLICIEUX!</p>
                </div>
                <div class="inscription-description">
                    <h3>Rejoignez-nous !</h3>
                    <p>
                        Créez votre compte en quelques étapes et profitez de tous nos
                        avantages : commandes rapides, offres exclusives et programme de
                        fidélité.
                    </p>
                </div>
            </div>
        </div>
        <!-- Partie droite - Formulaire multi-étapes -->
        <div class="inscription-right">
            <div class="inscription-form-container">
                <h2 class="text-center mb-4" style="color: white; font-weight: 800;">
                    <i class="bi bi-person-plus text-warning"></i> Créer un compte
                </h2>
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger">
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <div>@error.ErrorMessage</div>
                        }
                    </div>
                }
                <!-- Barre de progression -->
                <div class="progress-steps">
                    <div class="step active" data-step="1">
                        <div class="step-number">1</div>
                        <div class="step-label">Informations</div>
                    </div>
                    <div class="step" data-step="2">
                        <div class="step-number">2</div>
                        <div class="step-label">Coordonnées</div>
                    </div>
                    <div class="step" data-step="3">
                        <div class="step-number">3</div>
                        <div class="step-label">Sécurité</div>
                    </div>
                    <div class="step" data-step="4">
                        <div class="step-number">4</div>
                        <div class="step-label">Confirmation</div>
                    </div>
                </div>
                <form asp-action="Register" asp-controller="Account" method="post" id="formInscription">
                    <!-- Étape 1 : Informations personnelles -->
                    <div class="form-step active" data-step="1">
                        <h5 class="mb-4 text-warning">
                            <i class="bi bi-person-circle"></i> Informations personnelles
                        </h5>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <div class="form-floating">
                                    <input type="text" class="form-control" id="nom" name="nom" placeholder="Nom" required />
                                    <label for="nom">Nom *</label>
                                </div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <div class="form-floating">
                                    <input type="text" class="form-control" id="prenom" name="prenom" placeholder="Prénom" required />
                                    <label for="prenom">Prénom *</label>
                                </div>
                            </div>
                        </div>
                        <div class="d-flex justify-content-end">
                            <button type="button" class="btn btn-next" onclick="nextStep()">
                                Suivant <i class="bi bi-arrow-right"></i>
                            </button>
                        </div>
                    </div>
                    <!-- Étape 2 : Coordonnées -->
                    <div class="form-step" data-step="2">
                        <h5 class="mb-4 text-warning">
                            <i class="bi bi-geo-alt"></i> Coordonnées
                        </h5>
                        <div class="form-floating mb-3">
                            <input type="tel" class="form-control" id="telephone" name="telephone" placeholder="Téléphone" required />
                            <label for="telephone">Téléphone *</label>
                            <small class="text-muted">Format: +221XXXXXXXXX</small>
                        </div>
                        <div class="form-floating mb-3">
                            <input type="text" class="form-control" id="adresse" name="adresse" placeholder="Adresse" required />
                            <label for="adresse">Adresse complète *</label>
                        </div>
                        <div class="form-floating mb-3">
                            <select class="form-select" id="zone" name="zone" required style="background-color: rgba(255, 255, 255, 0.1); border: 2px solid rgba(255, 215, 0, 0.3); color: white;">
                                <option value="" style="background-color: var(--brasil-gray); color: rgba(255, 255, 255, 0.5);">Sélectionner une zone</option>
                                <option value="plateau" style="background-color: var(--brasil-gray); color: white;">Plateau</option>
                                <option value="almadies" style="background-color: var(--brasil-gray); color: white;">Almadies</option>
                                <option value="parcelles" style="background-color: var(--brasil-gray); color: white;">Parcelles Assainies</option>
                                <option value="grand-dakar" style="background-color: var(--brasil-gray); color: white;">Grand Dakar</option>
                                <option value="guediawaye" style="background-color: var(--brasil-gray); color: white;">Guédiawaye</option>
                            </select>
                            <label for="zone" style="color: rgba(255, 255, 255, 0.6);">Zone de livraison *</label>
                        </div>
                        <div class="d-flex justify-content-between">
                            <button type="button" class="btn btn-prev" onclick="prevStep()">
                                <i class="bi bi-arrow-left"></i> Précédent
                            </button>
                            <button type="button" class="btn btn-next" onclick="nextStep()">
                                Suivant <i class="bi bi-arrow-right"></i>
                            </button>
                        </div>
                    </div>
                    <!-- Étape 3 : Sécurité -->
                    <div class="form-step" data-step="3">
                        <h5 class="mb-4 text-warning">
                            <i class="bi bi-shield-lock"></i> Sécurité du compte
                        </h5>
                        <div class="form-floating mb-3">
                            <input type="email" class="form-control" id="email" name="email" placeholder="name@example.com" required />
                            <label for="email">Email *</label>
                        </div>
                        <div class="form-floating mb-3">
                            <input type="password" class="form-control" id="password" name="password" placeholder="Mot de passe" required />
                            <label for="password">Mot de passe *</label>
                            <small class="text-muted">Minimum 8 caractères</small>
                        </div>
                        <div class="form-floating mb-3">
                            <input type="password" class="form-control" id="confirmPassword" name="confirmPassword" placeholder="Confirmer le mot de passe" required />
                            <label for="confirmPassword">Confirmer le mot de passe *</label>
                        </div>
                        <div class="d-flex justify-content-between">
                            <button type="button" class="btn btn-prev" onclick="prevStep()">
                                <i class="bi bi-arrow-left"></i> Précédent
                            </button>
                            <button type="button" class="btn btn-next" onclick="nextStep()">
                                Suivant <i class="bi bi-arrow-right"></i>
                            </button>
                        </div>
                    </div>
                    <!-- Étape 4 : Confirmation -->
                    <div class="form-step" data-step="4">
                        <h5 class="mb-4 text-warning">
                            <i class="bi bi-check-circle"></i> Confirmation
                        </h5>
                        <div class="card mb-3" style="background-color: rgba(255, 215, 0, 0.1); border-color: var(--brasil-yellow);">
                            <div class="card-body">
                                <h6 class="text-warning">Récapitulatif</h6>
                                <div id="recapitulatif" class="mt-3" style="color: rgba(255, 255, 255, 0.8);">
                                    <!-- Sera rempli dynamiquement -->
                                </div>
                            </div>
                        </div>
                        <div class="d-flex justify-content-between">
                            <button type="button" class="btn btn-prev" onclick="prevStep()">
                                <i class="bi bi-arrow-left"></i> Précédent
                            </button>
                            <button type="submit" class="btn btn-submit">
                                <i class="bi bi-check-circle"></i> Créer mon compte
                            </button>
                        </div>
                    </div>
                </form>
                <div class="text-center mt-4">
                    <p class="text-muted">
                        Vous avez déjà un compte ?
                        <a href="/Account/Login" style="color: var(--brasil-yellow); text-decoration: none; font-weight: 600;">
                            Se connecter
                        </a>
                    </p>
                </div>
            </div>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        let currentStep = 1;
        const totalSteps = 4;

        function updateStepIndicators() {
            document.querySelectorAll(".step").forEach((step, index) => {
                const stepNumber = index + 1;
                if (stepNumber < currentStep) {
                    step.classList.add("completed");
                    step.classList.remove("active");
                } else if (stepNumber === currentStep) {
                    step.classList.add("active");
                    step.classList.remove("completed");
                } else {
                    step.classList.remove("active", "completed");
                }
            });

            document.querySelectorAll(".form-step").forEach((step, index) => {
                if (index + 1 === currentStep) {
                    step.classList.add("active");
                } else {
                    step.classList.remove("active");
                }
            });

            // Remplir le récapitulatif à l'étape 4
            if (currentStep === 4) {
                const recap = `
                    <p><strong>Nom:</strong> ${document.getElementById("nom").value} ${document.getElementById("prenom").value}</p>
                    <p><strong>Téléphone:</strong> ${document.getElementById("telephone").value}</p>
                    <p><strong>Adresse:</strong> ${document.getElementById("adresse").value}</p>
                    <p><strong>Email:</strong> ${document.getElementById("email").value}</p>
                `;
                document.getElementById("recapitulatif").innerHTML = recap;
            }
        }

        function nextStep() {
            // Validation simple
            const currentStepElement = document.querySelector(`.form-step[data-step="${currentStep}"]`);
            const inputs = currentStepElement.querySelectorAll("input[required], select[required]");
            let valid = true;

            inputs.forEach((input) => {
                if (!input.value) {
                    valid = false;
                    input.classList.add("is-invalid");
                } else {
                    input.classList.remove("is-invalid");
                }
            });

            if (!valid) {
                alert("Veuillez remplir tous les champs obligatoires");
                return;
            }

            // Validation spécifique pour l'étape 3 (mots de passe)
            if (currentStep === 3) {
                const password = document.getElementById("password").value;
                const confirmPassword = document.getElementById("confirmPassword").value;

                if (password.length < 8) {
                    alert("Le mot de passe doit contenir au moins 8 caractères");
                    return;
                }

                if (password !== confirmPassword) {
                    alert("Les mots de passe ne correspondent pas");
                    return;
                }
            }

            if (currentStep < totalSteps) {
                currentStep++;
                updateStepIndicators();
            }
        }

        function prevStep() {
            if (currentStep > 1) {
                currentStep--;
                updateStepIndicators();
            }
        }

        // Initialisation
        updateStepIndicators();
    </script>
</body>
</html>
