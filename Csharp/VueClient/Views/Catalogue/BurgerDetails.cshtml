@model VueClient.Models.Burger
@{
    ViewData["Title"] = Model.Nom;
}

<link rel="stylesheet" href="~/css/catalogue.css" />

<div class="main-content">
    <!-- Fil d'Ariane -->
    <nav aria-label="breadcrumb" style="margin-bottom: 2rem;">
        <ol class="breadcrumb" style="background: transparent; padding: 0;">
            <li class="breadcrumb-item">
                <a asp-action="Index" style="color: var(--brasil-yellow); text-decoration: none;">
                    <i class="bi bi-house-door"></i> Catalogue
                </a>
            </li>
            <li class="breadcrumb-item active" aria-current="page" style="color: white;">@Model.Nom</li>
        </ol>
    </nav>

    <!-- Détails du produit -->
    <div class="product-detail-container">
        <div class="product-detail-grid">
            <!-- Image du produit -->
            <div class="product-detail-image">
                @if (!string.IsNullOrEmpty(Model.Image))
                {
                    <img src="@Model.Image" alt="@Model.Nom" />
                }
                else
                {
                    <img src="https://via.placeholder.com/500x400/1a1a1a/ffc107?text=@Model.Nom" alt="@Model.Nom" />
                }
            </div>

            <!-- Informations du produit -->
            <div class="product-detail-info">
                <h1 class="product-detail-name">@Model.Nom</h1>
                
                <div class="product-detail-description">
                    <p>@Model.Description</p>
                </div>

                @if (Model.Menus != null && Model.Menus.Any())
                {
                    <div class="product-detail-menus" style="margin: 1.5rem 0; padding: 1rem; background: rgba(255, 193, 7, 0.1); border-radius: 8px; border-left: 3px solid var(--brasil-yellow);">
                        <h5 style="color: var(--brasil-yellow); margin-bottom: 0.75rem;">
                            <i class="bi bi-box-seam"></i> Disponible dans les menus :
                        </h5>
                        <ul style="list-style: none; padding: 0; margin: 0;">
                            @foreach (var menu in Model.Menus.Where(m => !m.IsArchive))
                            {
                                <li style="margin-bottom: 0.5rem;">
                                    <a asp-action="MenuDetails" asp-route-id="@menu.Id" style="color: white; text-decoration: none; transition: all 0.3s ease;">
                                        <i class="bi bi-arrow-right-circle"></i> @menu.Nom - @menu.Prix.ToString("N0") FCFA
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>
                }

                <div class="product-detail-footer">
                    <div class="product-detail-price">
                        @Model.Prix.ToString("N0") FCFA
                    </div>
                    <form method="post" asp-controller="Panier" asp-action="Ajouter">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <input type="hidden" name="type" value="burger" />
                        <button type="submit" class="add-to-cart-btn">
                            <i class="bi bi-cart-plus"></i> Ajouter au panier
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .breadcrumb-item + .breadcrumb-item::before {
        content: ">";
        color: rgba(255, 255, 255, 0.5);
    }

    .product-detail-container {
        max-width: 1000px;
        margin: 0 auto;
    }

    .product-detail-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 3rem;
        background-color: var(--brasil-gray);
        border: 2px solid rgba(255, 193, 7, 0.3);
        border-radius: 15px;
        padding: 2rem;
    }

    .product-detail-image {
        position: relative;
        overflow: hidden;
        border-radius: 12px;
    }

    .product-detail-image img {
        width: 100%;
        height: auto;
        border-radius: 12px;
        transition: transform 0.4s ease;
    }

    .product-detail-image:hover img {
        transform: scale(1.05);
    }

    .product-detail-info {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

    .product-detail-name {
        font-size: 2rem;
        font-weight: 700;
        color: var(--brasil-yellow);
        margin-bottom: 1.5rem;
    }

    .product-detail-description {
        color: rgba(255, 255, 255, 0.85);
        line-height: 1.6;
        margin-bottom: 2rem;
    }

    .product-detail-footer {
        display: flex;
        align-items: center;
        gap: 2rem;
        margin-top: auto;
        padding-top: 2rem;
        border-top: 2px solid rgba(255, 193, 7, 0.2);
    }

    .product-detail-price {
        font-size: 2rem;
        font-weight: 700;
        color: var(--brasil-yellow);
    }

    .add-to-cart-btn {
        background-color: var(--brasil-yellow);
        color: var(--brasil-dark);
        border: none;
        padding: 1rem 2rem;
        border-radius: 8px;
        font-size: 1rem;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .add-to-cart-btn:hover {
        background-color: #ffb300;
        transform: translateY(-3px);
        box-shadow: 0 10px 25px rgba(255, 193, 7, 0.4);
    }

    .add-to-cart-btn:active {
        transform: translateY(-1px);
    }

    @@media (max-width: 768px) {
        .product-detail-grid {
            grid-template-columns: 1fr;
            gap: 2rem;
            padding: 1.5rem;
        }

        .product-detail-name {
            font-size: 1.5rem;
        }

        .product-detail-price {
            font-size: 1.5rem;
        }

        .product-detail-footer {
            flex-direction: column;
            gap: 1rem;
            align-items: stretch;
        }

        .add-to-cart-btn {
            width: 100%;
            justify-content: center;
        }
    }
</style>
