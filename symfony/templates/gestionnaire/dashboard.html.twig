{% extends "base.html.twig" %}

{% block title %}Dashboard - Brasil Burger
{% endblock %}

{% block body %}
	<h1 class="h2 mb-4">
		<i class="fa-solid fa-gauge-high text-warning"></i>
		Dashboard
	</h1>

	<div class="row g-4 mb-4">
		<div class="col-md-3">
			<div class="stat-card warning d-flex align-items-center gap-3">
				<i class="fa-solid fa-receipt stat-icon text-warning"></i>
				<div>
					<div class="stat-label">Commandes du jour</div>
					<div class="stat-value text-warning">{{ statistiques.commandesDuJour }}</div>
				</div>
			</div>
		</div>
		<div class="col-md-3">
			<div class="stat-card success d-flex align-items-center gap-3">
				<i class="fa-solid fa-circle-check stat-icon text-success"></i>
				<div>
					<div class="stat-label">Commandes validées</div>
					<div class="stat-value text-success">{{ statistiques.commandesValidees }}</div>
				</div>
			</div>
		</div>
		<div class="col-md-3">
			<div class="stat-card info d-flex align-items-center gap-3">
				<i class="fa-solid fa-sack-dollar stat-icon text-info"></i>
				<div>
					<div class="stat-label">Recettes du jour</div>
					<div class="stat-value text-info">{{ statistiques.recettesDuJour|number_format(0, ',', ' ') }}</div>
				</div>
			</div>
		</div>
		<div class="col-md-3">
			<div class="stat-card danger d-flex align-items-center gap-3">
				<i class="fa-solid fa-circle-xmark stat-icon text-danger"></i>
				<div>
					<div class="stat-label">Commandes annulées</div>
					<div class="stat-value text-danger">{{ statistiques.commandesAnnulees }}</div>
				</div>
			</div>
		</div>
	</div>

	<div class="row g-4">
		<div class="col-lg-8">
			<div class="card">
				<div class="card-header">Burgers / Menus les plus vendus</div>
				<div class="card-body">
					<table class="table table-hover align-middle">
						<thead>
							<tr>
								<th>Produit</th>
								<th>Type</th>
								<th class="text-center">Quantité</th>
								<th class="text-end">CA</th>
							</tr>
						</thead>
						<tbody>
							{% for produit in produitsVendus %}
								<tr>
									<td class="align-middle-custom">
										{% if produit.image_produit %}
											<img src="{{ produit.image_produit }}" class="product-image me-2 align-middle" onerror="this.style.display='none'"/>
										{% endif %}
										{% if produit.type_article == 'BURGER' %}
											<i class="fa-solid fa-hamburger text-warning me-1" style="font-size: 1.3em; vertical-align: middle"></i>
										{% elseif produit.type_article == 'MENU' %}
											<i class="fa-solid fa-list-ul text-warning me-1"></i>
										{% else %}
											<i class="fa-solid fa-mug-saucer text-warning me-1"></i>
										{% endif %}
										{{ produit.nom_produit|default('Produit #' ~ produit.id_article) }}
									</td>
									<td class="align-middle-custom">
										{% if produit.type_article == 'BURGER' %}
											<span class="badge bg-warning">
												<i class="fa-solid fa-hamburger me-1"></i>Burger
											</span>
										{% elseif produit.type_article == 'MENU' %}
											<span class="badge bg-info">
												<i class="fa-solid fa-list-ul me-1"></i>Menu
											</span>
										{% else %}
											<span class="badge bg-secondary">
												<i class="fa-solid fa-mug-saucer me-1"></i>Complément
											</span>
										{% endif %}
									</td>
									<td class="text-center align-middle-custom">{{ produit.total_quantite }}</td>
									<td class="text-end text-warning align-middle-custom">{{ produit.chiffre_affaires|number_format(0, ',', ' ') }}
										FCFA</td>
								</tr>
							{% else %}
								<tr>
									<td colspan="4" class="text-center text-muted">Aucun produit vendu aujourd'hui</td>
								</tr>
							{% endfor %}
						</tbody>
					</table>
				</div>
			</div>
		</div>

		<div class="col-lg-4">
			<div class="card">
				<div class="card-header">Commandes récentes</div>
				<div class="card-body">
					{% for commande in commandesRecentes %}
						<div class="commande-card {% if commande.etatCommande == 'EN_PREPARATION' %}commande-info{% elseif commande.etatCommande in ['LIVREE', 'RETIREE', 'CONSOMMEE_SUR_PLACE'] %}commande-success{% elseif commande.etatCommande == 'ANNULEE' %}commande-danger{% else %}commande-warning{% endif %}">
							<div class="d-flex justify-content-between">
								<strong>#CMD{{ '%05d'|format(commande.id) }}</strong>
								<span class="badge {% if commande.etatCommande == 'EN_PREPARATION' %}bg-info{% elseif commande.etatCommande in ['LIVREE', 'RETIREE', 'CONSOMMEE_SUR_PLACE'] %}bg-success{% elseif commande.etatCommande == 'ANNULEE' %}bg-danger{% else %}bg-warning{% endif %} commande-badge">
									{% if commande.etatCommande == 'EN_ATTENTE' %}En attente
										{% elseif commande.etatCommande == 'CONFIRMEE' %}Confirmée
										{% elseif commande.etatCommande == 'EN_PREPARATION' %}En préparation
										{% elseif commande.etatCommande == 'PRETE' %}Prête
										{% elseif commande.etatCommande == 'LIVREE' %}Livrée
										{% elseif commande.etatCommande == 'RETIREE' %}Retirée
										{% elseif commande.etatCommande == 'CONSOMMEE_SUR_PLACE' %}Sur place
										{% elseif commande.etatCommande == 'ANNULEE' %}Annulée
									{% endif %}
								</span>
							</div>
							<small>Client :
								{{ commande.client.prenom }}
								{{ commande.client.nom }}</small>
							<div class="text-warning fw-bold">{{ commande.montantTotal|number_format(0, ',', ' ') }}
								FCFA</div>
						</div>
					{% else %}
						<p class="text-center text-muted">Aucune commande récente</p>
					{% endfor %}
				</div>
			</div>
		</div>
	</div>
{% endblock %}
