{% extends 'base.html.twig' %}

{% block title %}Gestion des Commandes
{% endblock %}

{% block body %}
	<div class="container-fluid mt-4">
		<div class="d-flex justify-content-between align-items-center mb-4">
			<h1 class="h3 text-brasil-yellow mb-0">
				<i class="fas fa-receipt me-2"></i>
				Gestion des Commandes
			</h1>
		</div>

		{# Filtres #}
		<div class="card mb-4 bg-brasil-card">
			<div class="card-header">
				<i class="fas fa-filter me-2"></i>
				Filtres de recherche
			</div>
			<div class="card-body">
				<form method="get" action="{{ path('gestionnaire_commandes_liste') }}" class="row g-3">
					<div class="col-md-3">
						<label for="recherche" class="form-label">Rechercher un client</label>
						<input type="text" class="form-control" id="recherche" name="recherche" value="{{ filters.recherche }}" placeholder="Nom du client...">
					</div>

					<div class="col-md-2">
						<label for="etat" class="form-label">État</label>
						<select class="form-select" id="etat" name="etat">
							<option value="">Tous les états</option>
							<option value="EN_ATTENTE" {% if filters.etat == 'EN_ATTENTE' %} selected {% endif %}>En attente</option>
							<option value="CONFIRMEE" {% if filters.etat == 'CONFIRMEE' %} selected {% endif %}>Confirmée</option>
							<option value="EN_PREPARATION" {% if filters.etat == 'EN_PREPARATION' %} selected {% endif %}>En préparation</option>
							<option value="PRETE" {% if filters.etat == 'PRETE' %} selected {% endif %}>Prête</option>
							<option value="LIVREE" {% if filters.etat == 'LIVREE' %} selected {% endif %}>Livrée</option>
							<option value="RETIREE" {% if filters.etat == 'RETIREE' %} selected {% endif %}>Retirée</option>
							<option value="CONSOMMEE_SUR_PLACE" {% if filters.etat == 'CONSOMMEE_SUR_PLACE' %} selected {% endif %}>Consommée sur place</option>
							<option value="ANNULEE" {% if filters.etat == 'ANNULEE' %} selected {% endif %}>Annulée</option>
						</select>
					</div>

					<div class="col-md-2">
						<label for="type" class="form-label">Type</label>
						<select class="form-select" id="type" name="type">
							<option value="">Tous les types</option>
							<option value="SUR_PLACE" {% if filters.type == 'SUR_PLACE' %} selected {% endif %}>Sur place</option>
							<option value="A_RECUPERER" {% if filters.type == 'A_RECUPERER' %} selected {% endif %}>À récupérer</option>
							<option value="A_LIVRER" {% if filters.type == 'A_LIVRER' %} selected {% endif %}>À livrer</option>
						</select>
					</div>

					<div class="col-md-2">
						<label for="periode" class="form-label">Période</label>
						<select class="form-select" id="periode" name="periode">
							<option value="">Toutes les périodes</option>
							<option value="aujourd_hui" {% if filters.periode == 'aujourd_hui' %} selected {% endif %}>Aujourd'hui</option>
							<option value="cette_semaine" {% if filters.periode == 'cette_semaine' %} selected {% endif %}>Cette semaine</option>
							<option value="ce_mois" {% if filters.periode == 'ce_mois' %} selected {% endif %}>Ce mois</option>
						</select>
					</div>

					<div class="col-md-2">
						<label for="tri" class="form-label">Trier par</label>
						<select class="form-select" id="tri" name="tri">
							<option value="">Date (récentes)</option>
							<option value="montant" {% if filters.tri == 'montant' %} selected {% endif %}>Montant</option>
						</select>
					</div>

					<div class="col-md-1 d-flex align-items-end">
						<button type="submit" class="btn btn-brasil-yellow w-100">
							<i class="fas fa-search"></i>
						</button>
					</div>
				</form>
			</div>
		</div>

		{# Messages flash #}
		{% for message in app.flashes('success') %}
			<div class="alert alert-success alert-dismissible fade show" role="alert">
				<i class="fas fa-check-circle me-2"></i>
				{{ message }}
				<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
			</div>
		{% endfor %}
		{% for message in app.flashes('error') %}
			<div class="alert alert-danger alert-dismissible fade show" role="alert">
				<i class="fas fa-exclamation-circle me-2"></i>
				{{ message }}
				<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
			</div>
		{% endfor %}

		{# Tableau des commandes #}
		<div class="card bg-brasil-card">
			<div class="card-header d-flex justify-content-between align-items-center">
				<span>
					<i class="fas fa-list me-2"></i>
					Liste des commandes ({{ totalItems }}
					résultat{{ totalItems > 1 ? 's' : '' }})
				</span>
			</div>
			<div class="card-body p-0">
				{% if commandes|length > 0 %}
					<div class="table-responsive">
						<table class="table table-dark table-hover mb-0">
							<thead>
								<tr>
									<th>#Commande</th>
									<th>Client</th>
									<th>Date</th>
									<th>Montant</th>
									<th>Type</th>
									<th>État</th>
									<th>Livreur</th>
									<th class="text-center">Actions</th>
								</tr>
							</thead>
							<tbody>
								{% for commande in commandes %}
									<tr>
										<td>
											<strong>#{{ commande.id }}</strong>
										</td>
										<td>
											<i class="fas fa-user me-1"></i>
											{{ commande.client.nom }}
											{{ commande.client.prenom }}
										</td>
										<td>
											<i class="far fa-calendar-alt me-1"></i>
											{{ commande.dateCommande|date('d/m/Y H:i') }}
										</td>
										<td>
											<strong class="text-brasil-green">{{ commande.montantTotal|number_format(2, ',', ' ') }}
												FCFA</strong>
										</td>
										<td>
											{% if commande.typeLivraison == 'SUR_PLACE' %}
												<span class="badge bg-primary">
													<i class="fas fa-utensils me-1"></i>Sur place
												</span>
											{% elseif commande.typeLivraison == 'A_RECUPERER' %}
												<span class="badge bg-info">
													<i class="fas fa-shopping-bag me-1"></i>À récupérer
												</span>
											{% elseif commande.typeLivraison == 'A_LIVRER' %}
												<span class="badge bg-warning">
													<i class="fas fa-motorcycle me-1"></i>À livrer
												</span>
											{% endif %}
										</td>
										<td>
											{% if commande.etatCommande == 'EN_ATTENTE' %}
												<span class="badge bg-warning">
													<i class="far fa-clock me-1"></i>En attente
												</span>
											{% elseif commande.etatCommande == 'CONFIRMEE' %}
												<span class="badge bg-info">
													<i class="fas fa-check me-1"></i>Confirmée
												</span>
											{% elseif commande.etatCommande == 'EN_PREPARATION' %}
												<span class="badge bg-primary">
													<i class="fas fa-fire-burner me-1"></i>En préparation
												</span>
											{% elseif commande.etatCommande == 'PRETE' %}
												<span class="badge bg-success">
													<i class="fas fa-check-double me-1"></i>Prête
												</span>
											{% elseif commande.etatCommande == 'LIVREE' %}
												<span class="badge bg-secondary">
													<i class="fas fa-box-check me-1"></i>Livrée
												</span>
											{% elseif commande.etatCommande == 'RETIREE' %}
												<span class="badge bg-secondary">
													<i class="fas fa-hand-holding me-1"></i>Retirée
												</span>
											{% elseif commande.etatCommande == 'CONSOMMEE_SUR_PLACE' %}
												<span class="badge bg-secondary">
													<i class="fas fa-utensils me-1"></i>Consommée
												</span>
											{% elseif commande.etatCommande == 'ANNULEE' %}
												<span class="badge bg-danger">
													<i class="fas fa-times-circle me-1"></i>Annulée
												</span>
											{% endif %}
										</td>
										<td>
											{% if commande.livreur %}
												<i class="fas fa-motorcycle me-1"></i>
												{{ commande.livreur.nom }}
												{{ commande.livreur.prenom }}
											{% else %}
												<span class="text-muted">
													<i class="fas fa-minus me-1"></i>Non assigné
												</span>
											{% endif %}
										</td>
										<td class="text-center">
											<a href="{{ path('gestionnaire_commandes_details', {id: commande.id}) }}" class="btn btn-sm btn-brasil-cyan">
												<i class="fas fa-eye me-1"></i>Voir
											</a>
										</td>
									</tr>
								{% endfor %}
							</tbody>
						</table>
					</div>
				{% else %}
					<div class="text-center py-5">
						<i class="fas fa-inbox fa-3x text-muted mb-3"></i>
						<p class="text-muted">Aucune commande trouvée</p>
					</div>
				{% endif %}
			</div>

			{# Pagination #}
			{% if totalPages > 0 %}
				<div class="card-footer">
					<nav aria-label="Navigation des commandes">
						<ul
							class="pagination justify-content-center mb-0">
							{# Bouton Précédent #}
							<li class="page-item {% if currentPage == 1 %}disabled{% endif %}">
								<a class="page-link" href="{{ path('gestionnaire_commandes_liste', filters|merge({page: currentPage - 1})) }}">
									<i class="fas fa-chevron-left"></i>
								</a>
							</li>

							{# Pages #}
							{% for page in 1..totalPages %}
								{% if page == currentPage %}
									<li class="page-item active">
										<span class="page-link">{{ page }}</span>
									</li>
								{% elseif page == 1 or page == totalPages or (page >= currentPage - 1 and page <= currentPage + 1) %}
									<li class="page-item">
										<a class="page-link" href="{{ path('gestionnaire_commandes_liste', filters|merge({page: page})) }}">
											{{ page }}
										</a>
									</li>
								{% elseif page == currentPage - 2 or page == currentPage + 2 %}
									<li class="page-item disabled">
										<span class="page-link">...</span>
									</li>
								{% endif %}
							{% endfor %}

							{# Bouton Suivant #}
							<li class="page-item {% if currentPage == totalPages %}disabled{% endif %}">
								<a class="page-link" href="{{ path('gestionnaire_commandes_liste', filters|merge({page: currentPage + 1})) }}">
									<i class="fas fa-chevron-right"></i>
								</a>
							</li>
						</ul>
					</nav>
				</div>
			{% endif %}
		</div>
	</div>
{% endblock %}
