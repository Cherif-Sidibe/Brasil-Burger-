{% extends 'base.html.twig' %}

{% block title %}Affectation des Livreurs
{% endblock %}

{% block body %}
	<div
		class="container-fluid py-4">
		{# En-tête #}
		<h1 class="h3 mb-4 text-brasil-yellow">Affectation des Livreurs</h1>

		{# Messages flash #}
		{% for message in app.flashes('success') %}
			<div class="alert alert-success alert-dismissible fade show">
				<i class="fas fa-check-circle me-2"></i>
				{{ message }}
				<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
			</div>
		{% endfor %}
		{% for message in app.flashes('error') %}
			<div class="alert alert-danger alert-dismissible fade show">
				<i class="fas fa-exclamation-circle me-2"></i>
				{{ message }}
				<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
			</div>
		{% endfor %}
		{% for message in app.flashes('info') %}
			<div class="alert alert-info alert-dismissible fade show">
				<i class="fas fa-info-circle me-2"></i>
				{{ message }}
				<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
			</div>
		{% endfor %}

		<form method="post" action="{{ path('gestionnaire_livreurs_affecter') }}">
			<div
				class="row g-4">
				{# Colonne gauche : Liste des livreurs #}
				<div class="col-lg-4">
					<div class="card h-100" style="border: 2px solid var(--brasil-yellow); overflow: hidden;">
						<div class="card-header border-0" style="background: var(--brasil-yellow); color: #000;">
							<i class="fas fa-motorcycle me-2"></i>Livreurs
						</div>
						<div class="card-body p-3">
							{% if livreurs is empty %}
								<div class="text-center py-4">
									<i class="fas fa-user-slash fa-2x text-muted mb-2"></i>
									<p class="text-muted mb-0">Aucun livreur disponible</p>
								</div>
							{% else %}
								{% for livreur in livreurs %}
									<div class="card bg-dark mb-3" style="border: 2px solid var(--brasil-yellow);">
										<div class="card-body p-3">
											<div class="d-flex justify-content-between align-items-start mb-2">
												<div>
													<h5 class="mb-1 text-white">{{ livreur.nom }}
														{{ livreur.prenom }}</h5>
													<small class="text-muted">{{ livreur.telephone ?? 'Pas de téléphone' }}</small>
												</div>
												<span class="badge bg-success">Disponible</span>
											</div>
											<div class="mt-2">
												{% for zone in zones %}
													<span class="badge bg-secondary me-1">{{ zone.nom }}</span>
												{% endfor %}
											</div>
										</div>
									</div>
								{% endfor %}
							{% endif %}
						</div>
					</div>
				</div>

				{# Colonne droite : Commandes par zone #}
				<div class="col-lg-8">
					{% if commandesParZone is empty %}
						<div class="card" style="border: 2px solid var(--brasil-yellow); overflow: hidden;">
							<div class="card-body text-center py-5">
								<i class="fas fa-clipboard-check fa-3x text-muted mb-3"></i>
								<h5 class="text-muted">Aucune commande en attente de livreur</h5>
							</div>
						</div>
					{% else %}
						{% for zoneName, commandes in commandesParZone %}
							<div class="card mb-4" style="border: 2px solid var(--brasil-yellow); overflow: hidden;">
								<div class="card-header border-0" style="background: var(--brasil-yellow); color: #000;">
									<i class="fas fa-map-marker-alt me-2"></i>Zone:
									{{ zoneName }}
								</div>
								<div class="card-body p-3">
									<div class="row g-3">
										{% for commande in commandes %}
											<div class="col-md-6">
												<div class="card bg-dark h-100" style="border: 2px solid var(--brasil-yellow);">
													<div class="card-body p-3">
														<div class="d-flex justify-content-between align-items-start mb-2">
															<span class="fw-bold text-brasil-yellow">#CMD{{ '%05d'|format(commande.id) }}</span>
															<span class="badge bg-warning text-dark">{{ commande.etatCommande|replace({'_': ' '}) }}</span>
														</div>
														<div class="mb-2">
															<small class="text-white">{{ commande.client.nom }}
																{{ commande.client.prenom }}</small><br>
															<small class="text-muted">{{ commande.client.telephone ?? '-' }}</small><br>
															<small class="text-muted">{{ commande.adresseLivraison ?? 'Adresse non spécifiée' }}</small>
														</div>
														<div class="mb-3">
															<span class="text-brasil-green fw-bold">{{ commande.montantTotal|number_format(0, ',', ' ') }}
																FCFA</span>
														</div>
														<select name="affectations[{{ commande.id }}]" class="form-select form-select-sm bg-dark text-white border-secondary">
															<option value="">-- Sélectionner un livreur --</option>
															{% for livreur in livreurs %}
																<option value="{{ livreur.id }}">{{ livreur.nom }}
																	{{ livreur.prenom }}</option>
															{% endfor %}
														</select>
													</div>
												</div>
											</div>
										{% endfor %}
									</div>
								</div>
							</div>
						{% endfor %}

						{# Bouton de soumission #}
						<div class="text-end">
							<button type="submit" class="btn btn-brasil-yellow btn-lg">
								<i class="fas fa-check me-2"></i>Affecter les livreurs sélectionnés
							</button>
						</div>
					{% endif %}
				</div>
			</div>
		</form>
	</div>
{% endblock %}
