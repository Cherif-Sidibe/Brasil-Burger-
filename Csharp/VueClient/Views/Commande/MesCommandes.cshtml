@model IEnumerable<VueClient.Models.Commande>
@{
    ViewData["Title"] = "Mes Commandes";
}

<div class="container py-5">
    <div class="row">
        <div class="col-12">
            <!-- En-tête -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="h2">
                    <i class="bi bi-receipt-cutoff me-2"></i>Mes Commandes
                </h1>
                <a href="@Url.Action("Index", "Catalogue")" class="btn btn-primary">
                    <i class="bi bi-plus me-2"></i>Nouvelle commande
                </a>
            </div>

            @if (Model == null || !Model.Any())
            {
                <!-- Message si aucune commande -->
                <div class="card shadow-sm">
                    <div class="card-body text-center py-5">
                        <i class="bi bi-bag-x text-muted" style="font-size: 4rem;"></i>
                        <h4 class="mt-3">Aucune commande</h4>
                        <p class="text-muted">Vous n'avez pas encore passé de commande.</p>
                        <a href="@Url.Action("Index", "Catalogue")" class="btn btn-primary mt-2">
                            <i class="bi bi-shop me-2"></i>Découvrir notre catalogue
                        </a>
                    </div>
                </div>
            }
            else
            {
                <!-- Liste des commandes -->
                <div class="row g-4">
                    @foreach (var commande in Model)
                    {
                        <div class="col-12">
                            <div class="card shadow-sm">
                                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                                    <div>
                                        <h5 class="mb-0">
                                            <i class="bi bi-receipt me-2"></i>Commande #@commande.Id
                                        </h5>
                                        <small class="text-muted">
                                            @commande.DateCommande.ToString("dd/MM/yyyy à HH:mm")
                                        </small>
                                    </div>
                                    <div>
                                        @{
                                            var badgeClass = commande.EtatCommande switch
                                            {
                                                VueClient.Models.EtatCommandeEnum.EN_ATTENTE => "bg-warning text-dark",
                                                VueClient.Models.EtatCommandeEnum.EN_PREPARATION => "bg-info",
                                                VueClient.Models.EtatCommandeEnum.PRETE => "bg-primary",
                                                VueClient.Models.EtatCommandeEnum.CONFIRMEE => "bg-info",
                                                VueClient.Models.EtatCommandeEnum.LIVREE => "bg-success",
                                                VueClient.Models.EtatCommandeEnum.RETIREE => "bg-success",
                                                VueClient.Models.EtatCommandeEnum.CONSOMMEE_SUR_PLACE => "bg-success",
                                                VueClient.Models.EtatCommandeEnum.ANNULEE => "bg-danger",
                                                _ => "bg-secondary"
                                            };
                                            var etatText = commande.EtatCommande.ToString().Replace("_", " ");
                                        }
                                        <span class="badge @badgeClass">@etatText</span>
                                    </div>
                                </div>
                                <div class="card-body">
                                    <div class="row align-items-center">
                                        <div class="col-md-4">
                                            <p class="mb-1"><strong>Type :</strong></p>
                                            <p class="text-muted mb-0">
                                                @if (commande.TypeLivraison == VueClient.Models.TypeLivraisonEnum.SUR_PLACE)
                                                {
                                                    <i class="bi bi-shop me-1"></i>

                                                    @:Sur place
                                                }
                                                else if (commande.TypeLivraison ==
                                                VueClient.Models.TypeLivraisonEnum.A_RECUPERER)
                                                {
                                                    <i class="bi bi-bag me-1"></i>

                                                    @:À récupérer
                                                }
                                                else
                                                {
                                                    <i class="bi bi-truck me-1"></i>

                                                    @:Livraison
                                                }
                                            </p>
                                        </div>
                                        <div class="col-md-4">
                                            @if (commande.Zone != null)
                                            {
                                                <p class="mb-1"><strong>Zone :</strong></p>
                                                <p class="text-muted mb-0">
                                                    <i class="bi bi-geo-alt me-1"></i>@commande.Zone.Nom
                                                </p>
                                            }
                                        </div>
                                        <div class="col-md-4 text-md-end">
                                            <p class="mb-1"><strong>Montant total :</strong></p>
                                            <p class="h5 text-primary mb-0">
                                                @commande.MontantTotal.ToString("N0") FCFA
                                            </p>
                                        </div>
                                    </div>
                                </div>
                                <div class="card-footer bg-white d-flex justify-content-between align-items-center">
                                    <div>
                                        @if (commande.Paiement != null)
                                        {
                                            var paiementBadge = commande.Paiement.StatutPaiement switch
                                            {
                                                VueClient.Models.StatutPaiementEnum.EN_ATTENTE => "bg-warning text-dark",
                                                VueClient.Models.StatutPaiementEnum.REUSSI => "bg-success",
                                                VueClient.Models.StatutPaiementEnum.ECHEC => "bg-danger",
                                                _ => "bg-secondary"
                                            };
                                            <span class="badge @paiementBadge">
                                                <i class="bi bi-credit-card me-1"></i>
                                                @commande.Paiement.StatutPaiement.ToString().Replace("_", " ")
                                            </span>
                                        }
                                    </div>
                                    <a href="@Url.Action("Details", "Commande", new { id = commande.Id })"
                                        class="btn btn-outline-primary btn-sm">
                                        <i class="bi bi-eye me-1"></i>Voir les détails
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>