<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Brasil Burger</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700;800;900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.2/font/bootstrap-icons.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/catalogue.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header class="header">
        <div class="header-container">
            <div class="logo">
                <span class="logo-brasil">Brasil</span>
                <span class="logo-burger">BURGER</span>
            </div>

            <button class="mobile-menu-toggle" onclick="toggleMobileMenu()" aria-label="Menu">
                <i class="bi bi-list"></i>
            </button>

            <nav class="nav-menu" id="navMenu">
                <a asp-controller="Catalogue" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Catalogue" ? "active" : "")">
                    <i class="bi bi-grid-3x3-gap"></i> Menu
                </a>
                <a asp-controller="Commande" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Commande" ? "active" : "")">
                    <i class="bi bi-receipt"></i> Commande
                </a>
            </nav>

            <div class="nav-icons">
                <button class="icon-btn" onclick="window.location.href='@Url.Action("Index", "Panier")'">
                    <i class="bi bi-cart3"></i>
                </button>
                <div class="dropdown">
                    <button class="account-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-person-circle"></i> Mon Compte
                        <i class="bi bi-caret-down-fill"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li>
                            <a asp-controller="Profil" asp-action="Index" class="dropdown-item">
                                <i class="bi bi-person"></i>
                                <span>Mon Profil</span>
                            </a>
                        </li>
                        <li>
                            <a asp-controller="Commande" asp-action="MesCommandes" class="dropdown-item">
                                <i class="bi bi-receipt"></i>
                                <span>Mes Commandes</span>
                            </a>
                        </li>
                        <li>
                            <a asp-controller="Panier" asp-action="Index" class="dropdown-item">
                                <i class="bi bi-cart3"></i>
                                <span>Mon Panier</span>
                            </a>
                        </li>
                        <li>
                            <a asp-controller="Auth" asp-action="Logout" class="dropdown-item">
                                <i class="bi bi-box-arrow-right"></i>
                                <span>Déconnexion</span>
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </header>

    <main>
        @RenderBody()
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
