{% extends 'base.html.twig' %}

{% block title %}Commande #{{ commande.id }}
{% endblock %}

{% block body %}
	<div
		class="container-fluid py-4">
		{# En-tête #}
		<div class="d-flex justify-content-between align-items-center mb-5">
			<h1 class="h3 text-brasil-yellow mb-0">
				<i class="fas fa-receipt me-2"></i>Commande #{{ commande.id }}
			</h1>
			<a href="{{ path('gestionnaire_commandes_liste') }}" class="btn btn-outline-brasil-yellow">
				<i class="fas fa-arrow-left me-2"></i>Retour
			</a>
		</div>

		{# Messages flash #}
		{% for message in app.flashes('success') %}
			<div class="alert alert-success alert-dismissible fade show mb-4">
				<i class="fas fa-check-circle me-2"></i>
				{{ message }}
				<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
			</div>
		{% endfor %}
		{% for message in app.flashes('error') %}
			<div class="alert alert-danger alert-dismissible fade show mb-4">
				<i class="fas fa-exclamation-circle me-2"></i>
				{{ message }}
				<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
			</div>
		{% endfor %}

		{# Bento Grid Layout #}
		<div
			class="row g-4">
			{# État - Grande carte en haut à gauche #}
			<div class="col-lg-5">
				<div class="card bg-brasil-card h-100 border-brasil-yellow" style="border-width: 2px;">
					<div class="card-body p-4">
						<h5 class="mb-4">
							<i class="fas fa-tasks me-2 text-brasil-yellow"></i>État de la commande</h5>

						<div class="mb-4">
							{% if commande.etatCommande == 'EN_ATTENTE' %}
								<h3>
									<span class="badge bg-warning text-dark fs-4">
										<i class="fas fa-clock me-2"></i>En attente</span>
								</h3>
							{% elseif commande.etatCommande == 'CONFIRMEE' %}
								<h3>
									<span class="badge bg-info fs-4">
										<i class="fas fa-check me-2"></i>Confirmée</span>
								</h3>
							{% elseif commande.etatCommande == 'EN_PREPARATION' %}
								<h3>
									<span class="badge bg-primary fs-4">
										<i class="fas fa-fire me-2"></i>En préparation</span>
								</h3>
							{% elseif commande.etatCommande == 'PRETE' %}
								<h3>
									<span class="badge bg-success fs-4">
										<i class="fas fa-check-double me-2"></i>Prête</span>
								</h3>
							{% elseif commande.etatCommande == 'LIVREE' %}
								<h3>
									<span class="badge bg-secondary fs-4">
										<i class="fas fa-box me-2"></i>Livrée</span>
								</h3>
							{% elseif commande.etatCommande == 'RETIREE' %}
								<h3>
									<span class="badge bg-secondary fs-4">
										<i class="fas fa-hand-paper me-2"></i>Retirée</span>
								</h3>
							{% elseif commande.etatCommande == 'CONSOMMEE_SUR_PLACE' %}
								<h3>
									<span class="badge bg-secondary fs-4">
										<i class="fas fa-check-circle me-2"></i>Consommée</span>
								</h3>
							{% elseif commande.etatCommande == 'ANNULEE' %}
								<h3>
									<span class="badge bg-danger fs-4">
										<i class="fas fa-times me-2"></i>Annulée</span>
								</h3>
							{% endif %}
						</div>

						{% if commande.etatCommande != 'ANNULEE' and commande.etatCommande != 'LIVREE' and commande.etatCommande != 'RETIREE' and commande.etatCommande != 'CONSOMMEE_SUR_PLACE' %}
							<form method="post" action="{{ path('gestionnaire_commandes_changer_etat', {id: commande.id}) }}" id="changerEtatForm">
								<label class="form-label fw-bold">Modifier l'état</label>
								<select class="form-select form-select-lg mb-3" name="etat" required>
									<option value="">-- Sélectionner --</option>
									{% if commande.etatCommande == 'EN_ATTENTE' %}
										<option value="CONFIRMEE">Confirmer</option>
										<option value="ANNULEE">Annuler</option>
									{% endif %}
									{% if commande.etatCommande == 'CONFIRMEE' %}
										<option value="EN_PREPARATION">Démarrer préparation</option>
										<option value="ANNULEE">Annuler</option>
									{% endif %}
									{% if commande.etatCommande == 'EN_PREPARATION' %}
										<option value="PRETE">Marquer prête</option>
									{% endif %}
									{% if commande.etatCommande == 'PRETE' %}
										{% if commande.typeLivraison == 'A_LIVRER' %}
											<option value="LIVREE">Marquer livrée</option>
										{% elseif commande.typeLivraison == 'A_RECUPERER' %}
											<option value="RETIREE">Marquer retirée</option>
										{% elseif commande.typeLivraison == 'SUR_PLACE' %}
											<option value="CONSOMMEE_SUR_PLACE">Marquer consommée</option>
										{% endif %}
									{% endif %}
								</select>
								<button type="button" class="btn btn-brasil-yellow btn-lg w-100" data-bs-toggle="modal" data-bs-target="#confirmEtatModal">
									<i class="fas fa-save me-2"></i>Enregistrer
								</button>
							</form>
						{% endif %}
					</div>
				</div>
			</div>

			{# Colonne droite avec 2 petites cartes empilées #}
			<div
				class="col-lg-3">
				{# Date #}
				<div class="card bg-brasil-card mb-4" style="min-height: 140px;">
					<div class="card-body p-4 text-center">
						<div class="text-muted mb-2">Date</div>
						<div class="fs-4 fw-bold">{{ commande.dateCommande|date('d/m/Y') }}</div>
						<div class="text-brasil-yellow">{{ commande.dateCommande|date('H:i') }}</div>
					</div>
				</div>

				{# Type service #}
				<div class="card bg-brasil-card" style="min-height: 140px;">
					<div class="card-body p-4 text-center">
						<div class="text-muted mb-3">Service</div>
						{% if commande.typeLivraison == 'SUR_PLACE' %}
							<div class="mb-2">
								<i class="fas fa-utensils fa-2x text-primary"></i>
							</div>
							<div class="fw-bold">Sur place</div>
						{% elseif commande.typeLivraison == 'A_RECUPERER' %}
							<div class="mb-2">
								<i class="fas fa-shopping-bag fa-2x text-info"></i>
							</div>
							<div class="fw-bold">À récupérer</div>
						{% else %}
							<div class="mb-2">
								<i class="fas fa-motorcycle fa-2x text-warning"></i>
							</div>
							<div class="fw-bold">À livrer</div>
						{% endif %}
					</div>
				</div>
			</div>

			{# Montant - Grande carte #}
			<div class="col-lg-4">
				<div class="card bg-brasil-card h-100" style="min-height: 296px;">
					<div class="card-body p-5 d-flex flex-column justify-content-center align-items-center text-center">
						<div class="text-muted mb-3">Montant total</div>
						<div class="display-3 text-brasil-green fw-bold">{{ commande.montantTotal|number_format(0, ',', ' ') }}</div>
						<div class="fs-5 text-muted mt-2">FCFA</div>
					</div>
				</div>
			</div>

			{# Articles - Grande carte pleine largeur #}
			<div class="col-12">
				<div class="card bg-brasil-card">
					<div class="card-body p-4">
						<h5 class="mb-4">
							<i class="fas fa-shopping-cart me-2 text-brasil-yellow"></i>Articles commandés</h5>
						<div class="table-responsive">
							<table class="table table-hover">
								<thead>
									<tr>
										<th>Article</th>
										<th class="text-center">Qté</th>
										<th class="text-end">Prix unitaire</th>
										<th class="text-end">Total</th>
									</tr>
								</thead>
								<tbody>
									{% for detail in details %}
										<tr>
											<td>
												{% if detail.typeArticle == 'BURGER' %}
													<i class="fas fa-hamburger text-warning me-2"></i>
												{% elseif detail.typeArticle == 'MENU' %}
													<i class="fas fa-utensils text-success me-2"></i>
												{% elseif detail.typeArticle == 'COMPLEMENT' %}
													<i class="fas fa-glass-water text-info me-2"></i>
												{% endif %}
												{{ detail.articleNom ?? 'Article supprimé' }}
											</td>
											<td class="text-center">
												<span class="badge bg-secondary">{{ detail.quantite }}</span>
											</td>
											<td class="text-end">{{ detail.prixUnitaire|number_format(0, ',', ' ') }}
												FCFA</td>
											<td class="text-end fw-bold">{{ (detail.quantite * detail.prixUnitaire)|number_format(0, ',', ' ') }}
												FCFA</td>
										</tr>
									{% endfor %}
								</tbody>
								<tfoot>
									<tr class="border-top border-brasil-yellow" style="border-width: 2px !important;">
										<th colspan="3" class="text-end pt-3">TOTAL</th>
										<th class="text-end text-brasil-green fs-4 pt-3">{{ commande.montantTotal|number_format(0, ',', ' ') }}
											FCFA</th>
									</tr>
								</tfoot>
							</table>
						</div>
					</div>
				</div>
			</div>

			{# Client #}
			<div class="col-lg-6">
				<div class="card bg-brasil-card h-100">
					<div class="card-body p-4">
						<h5 class="mb-4">
							<i class="fas fa-user me-2 text-brasil-yellow"></i>Client</h5>
						<div class="mb-4">
							<div class="fs-3 fw-bold mb-3">{{ commande.client.nom }}
								{{ commande.client.prenom }}</div>
							<div class="mb-2">
								<i class="fas fa-envelope text-brasil-cyan me-2"></i>
								{{ commande.client.email }}
							</div>
							{% if commande.client.telephone %}
								<div class="mb-2">
									<i class="fas fa-phone text-brasil-green me-2"></i>
									{{ commande.client.telephone }}
								</div>
							{% endif %}
							{% if commande.client.adresse %}
								<div>
									<i class="fas fa-map-marker-alt text-danger me-2"></i>
									{{ commande.client.adresse }}
								</div>
							{% endif %}
						</div>
					</div>
				</div>
			</div>

			{# Livraison #}
			{% if commande.typeLivraison == 'A_LIVRER' %}
				<div class="col-lg-6">
					<div class="card bg-brasil-card h-100">
						<div class="card-body p-4">
							<h5 class="mb-4">
								<i class="fas fa-shipping-fast me-2 text-brasil-yellow"></i>Livraison</h5>

							{% if commande.adresseLivraison %}
								<div class="mb-3">
									<div class="text-muted small mb-1">Adresse</div>
									<div>
										<i class="fas fa-map-marker-alt text-danger me-2"></i>
										{{ commande.adresseLivraison }}</div>
								</div>
							{% endif %}

							{% if commande.zone %}
								<div class="mb-3">
									<div class="text-muted small mb-1">Zone</div>
									<div>
										{{ commande.zone.nom }}
										<span class="badge bg-info ms-2">{{ commande.zone.prixLivraison|number_format(0, ',', ' ') }}
											FCFA</span>
									</div>
								</div>
							{% endif %}

							<div class="text-muted small mb-2">Livreur</div>
							{% if commande.livreur %}
								<div class="alert alert-success mb-0">
									<i class="fas fa-motorcycle me-2"></i>
									<strong>{{ commande.livreur.nom }}
										{{ commande.livreur.prenom }}</strong>
									{% if commande.livreur.telephone %}
										<div class="mt-2 small">
											<i class="fas fa-phone me-2"></i>
											{{ commande.livreur.telephone }}</div>
									{% endif %}
								</div>
							{% else %}
								<div class="alert alert-warning mb-3">
									<i class="fas fa-exclamation-triangle me-2"></i>Non assigné
								</div>
								<form method="post" action="{{ path('gestionnaire_commandes_assigner_livreur', {id: commande.id}) }}" id="assignerLivreurForm">
									<select class="form-select mb-2" name="id_livreur" required>
										<option value="">Sélectionner un livreur</option>
										{% for livreur in livreurs %}
											<option value="{{ livreur.id }}">{{ livreur.nom }}
												{{ livreur.prenom }}
												{% if livreur.telephone %}
													-
													{{ livreur.telephone }}
												{% endif %}
											</option>
										{% endfor %}
									</select>
									<button type="button" class="btn btn-brasil-yellow w-100" data-bs-toggle="modal" data-bs-target="#confirmAssignerModal">
										<i class="fas fa-user-check me-1"></i>Assigner
									</button>
								</form>
							{% endif %}
						</div>
					</div>
				</div>
			{% endif %}
		</div>
	</div>

	{# Modal confirmation changement d'état #}
	<div class="modal fade" id="confirmEtatModal" tabindex="-1">
		<div class="modal-dialog">
			<div class="modal-content bg-dark">
				<div class="modal-header border-secondary">
					<h5 class="modal-title">
						<i class="fas fa-edit me-2 text-brasil-yellow"></i>Confirmer
					</h5>
					<button type="button" class="btn-close" data-bs-dismiss="modal"></button>
				</div>
				<div class="modal-body">
					Confirmer le changement d'état ?
				</div>
				<div class="modal-footer border-secondary">
					<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
					<button type="button" class="btn btn-brasil-yellow" onclick="document.getElementById('changerEtatForm').submit()">
						Confirmer
					</button>
				</div>
			</div>
		</div>
	</div>

	{# Modal confirmation assignation livreur #}
	<div class="modal fade" id="confirmAssignerModal" tabindex="-1">
		<div class="modal-dialog">
			<div class="modal-content bg-dark">
				<div class="modal-header border-secondary">
					<h5 class="modal-title">
						<i class="fas fa-user-check me-2 text-brasil-yellow"></i>Confirmer
					</h5>
					<button type="button" class="btn-close" data-bs-dismiss="modal"></button>
				</div>
				<div class="modal-body">
					Confirmer l'assignation ?
				</div>
				<div class="modal-footer border-secondary">
					<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
					<button type="button" class="btn btn-brasil-yellow" onclick="document.getElementById('assignerLivreurForm').submit()">
						Confirmer
					</button>
				</div>
			</div>
		</div>
	</div>
{% endblock %}
