<!DOCTYPE html>
<html lang="fr">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>Dashboard - Brasil Burger</title>

		<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.2/font/bootstrap-icons.css">

		<style>:root
		{
			--brasil-yellow: #ffd700;
			--brasil-gold: #ffc107;
		}

		body {
			background: #111;
			min-height: 100vh;
			font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
		}

		.success-box {
			background: #000;
			border: 2.5px solid var(--brasil-yellow);
			border-radius: 26px;
			padding: 48px 36px;
			box-shadow: 0 10px 35px rgba(255, 215, 0, 0.18);
			max-width: 500px;
			animation: fadeIn 0.8s ease;
		}

		@keyframes fadeIn {
			from {
				opacity: 0;
				transform: translateY(20px);
			}
			to {
				opacity: 1;
				transform: translateY(0);
			}
		}

		.success-message {
			color: var(--brasil-yellow);
			font-size: 1.5rem;
			font-weight: 700;
			text-align: center;
			margin-bottom: 20px;
		}

		.welcome-text {
			color: #fff;
			text-align: center;
			font-size: 1.1rem;
		}

		.btn-logout {
			background: var(--brasil-yellow);
			color: #111;
			font-weight: 600;
			border: none;
			padding: 10px 25px;
			border-radius: 10px;
			transition: all 0.3s ease;
		}

		.btn-logout:hover {
			background: var(--brasil-gold);
			transform: translateY(-2px);
			box-shadow: 0 5px 15px rgba(255, 215, 0, 0.3);
		}
	</style>
</head>
<body>
	<div class="d-flex justify-content-center align-items-center min-vh-100">
		<div class="success-box text-center">
			<div class="text-center mb-4">
				<img src="https://d1mzjggyz5012h.cloudfront.net/whatsaf.com/logos/ba09d1b6bd0ea38a_75620eb8bad113b4_Logo-Brasil-Burger.png?width=300" alt="Brasil Burger" style="max-width: 180px" onerror="this.style.display='none'"/>
			</div>

			<div class="success-message">
				<i class="bi bi-check-circle-fill"></i>
				Connexion Réussie
			</div>

			<div class="welcome-text mb-4">
				Bienvenue
				<strong>{{ user.prenom }}
					{{ user.nom }}</strong><br>
				Espace Gestionnaire Brasil Burger
			</div>

			<a href="{{ path('app_logout') }}" class="btn btn-logout">
				<i class="bi bi-box-arrow-right"></i>
				Déconnexion
			</a>
		</div>
	</div>

	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body></html>
